def _self_path() -> Path:
    return Path(__file__).resolve()


def _app_bundle_identifier(app_path: Path) -> str:
    info_plist = app_path / "Contents" / "Info.plist"
    try:
        with info_plist.open("rb") as fh:
            payload = plistlib.load(fh)
    except Exception as exc:  # noqa: BLE001
        raise RuntimeError(f"cannot read app bundle identifier from {info_plist}: {exc}") from exc
    bundle_id = str(payload.get("CFBundleIdentifier") or "").strip()
    if not bundle_id:
        raise RuntimeError(f"missing CFBundleIdentifier in {info_plist}")
    return bundle_id


def _codesign_team_identifier(path: Path) -> str:
    result = _run_capture(["/usr/bin/codesign", "-dv", "--verbose=2", str(path)], timeout=10)
    for line in result.stdout.splitlines():
        if line.startswith("TeamIdentifier="):
            return line.split("=", 1)[1].strip()
    return ""


def _is_openai_signed(path: Path) -> bool:
    return path.exists() and _codesign_team_identifier(path) == OPENAI_TEAM_ID


def _verify_openai_codex_app() -> str:
    bundle_id = _app_bundle_identifier(OPENAI_CODEX_APP)
    if bundle_id != OPENAI_CODEX_BUNDLE_ID:
        if bundle_id == WAVES_CODEX_BUNDLE_ID:
            raise RuntimeError(
                f"{OPENAI_CODEX_APP} resolves to Waves CODEX ({bundle_id}), not OpenAI Codex"
            )
        raise RuntimeError(
            f"{OPENAI_CODEX_APP} has bundle id {bundle_id}, expected {OPENAI_CODEX_BUNDLE_ID}"
        )
    return bundle_id


def _ensure_codex_app_path_state() -> bool:
    _verify_openai_codex_app()
    desired = str(OPENAI_CODEX_APP)
    current = CODEX_APP_PATH_STATE.read_text(encoding="utf-8").strip() if CODEX_APP_PATH_STATE.exists() else ""
    if current == desired:
        return False
    CODEX_APP_PATH_STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = CODEX_APP_PATH_STATE.with_name(CODEX_APP_PATH_STATE.name + f".tmp-{os.getpid()}")
    tmp.write_text(desired + "\n", encoding="utf-8")
    os.replace(tmp, CODEX_APP_PATH_STATE)
    return True


def _log(level: str, message: str, **fields: Any) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        payload = {
            "ts": int(time.time()),
            "level": level,
            "message": message,
        }
        if fields:
            payload["fields"] = fields
        with LOG.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(payload, ensure_ascii=True) + "\n")
    except Exception:
        pass


def _write_status_snapshot(payload: dict[str, Any]) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        snapshot = {
            "ts": int(time.time()),
            "payload": payload,
        }
        tmp = STATUS_SNAPSHOT.with_name(STATUS_SNAPSHOT.name + f".tmp-{os.getpid()}")
        tmp.write_text(json.dumps(snapshot, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        os.replace(tmp, STATUS_SNAPSHOT)
    except Exception:
        pass


def _write_native_smoke(payload: dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = NATIVE_SMOKE_STATUS.with_name(NATIVE_SMOKE_STATUS.name + f".tmp-{os.getpid()}")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, NATIVE_SMOKE_STATUS)


def _load_native_smoke_raw() -> dict[str, Any] | None:
    try:
        with NATIVE_SMOKE_STATUS.open("r", encoding="utf-8") as fh:
            payload = json.load(fh)
    except Exception:
        return None
    return payload if isinstance(payload, dict) else None


def _file_fingerprint(path: Path) -> dict[str, Any]:
    try:
        stat = path.stat()
    except Exception:
        return {"path": str(path), "exists": False}
    return {
        "path": str(path),
        "exists": True,
        "size": stat.st_size,
        "mtime_ns": stat.st_mtime_ns,
    }


def _boot_session_marker() -> str:
    try:
        result = _run_capture(["/usr/sbin/sysctl", "-n", "kern.boottime"], timeout=2)
    except Exception:
        return ""
    if result.returncode != 0:
        return ""
    match = re.search(r"sec\s*=\s*(\d+)", result.stdout)
    return match.group(1) if match else result.stdout.strip()


def _bundled_computer_use_version() -> str:
    manifest_path = COMPUTER_USE_SOURCE / ".codex-plugin" / "plugin.json"
    try:
        with manifest_path.open("r", encoding="utf-8-sig") as fh:
            payload = json.load(fh)
    except Exception:
        return ""
    return str(payload.get("version") or "")


def _current_native_smoke_context() -> dict[str, Any]:
    version = _bundled_computer_use_version()
    cache_root = CACHE_BASE / version if version else CACHE_BASE
    native_binary = _preferred_native_binary_path(cache_root)
    return {
        "boot_session": _boot_session_marker(),
        "codex_app": str(OPENAI_CODEX_APP),
        "codex_exec": _file_fingerprint(OPENAI_CODEX_EXEC),
        "computer_use_version": version,
        "native_binary": _file_fingerprint(native_binary),
        "guard": _file_fingerprint(_self_path()),
    }


def _native_smoke_status(payload: dict[str, Any] | None = None) -> dict[str, Any]:
    raw = payload if payload is not None else _load_native_smoke_raw()
    now = int(time.time())
    current_context = _current_native_smoke_context()
    if raw is None:
        return {
            "ok": False,
            "fresh": False,
            "authoritative": False,
            "appserver_rendezvous": False,
            "operational": False,
            "second_mouse_verified": False,
            "failure_class": "no_native_smoke_record",
            "error": f"no native smoke record at {NATIVE_SMOKE_STATUS}",
            "path": str(NATIVE_SMOKE_STATUS),
            "max_age_seconds": NATIVE_SMOKE_MAX_AGE_SECONDS,
            "current_smoke_context": current_context,
        }
    recorded_at = int(raw.get("recorded_at") or 0)
    age_seconds = max(0, now - recorded_at) if recorded_at else None
    age_fresh = recorded_at > 0 and age_seconds is not None and age_seconds <= NATIVE_SMOKE_MAX_AGE_SECONDS
    smoke_context = raw.get("smoke_context") if isinstance(raw.get("smoke_context"), dict) else {}
    context_matches = bool(smoke_context) and smoke_context == current_context
    fresh = age_fresh and context_matches
    source = str(raw.get("source") or "")
    fallback_used = bool(raw.get("fallback_used"))
    verified_by_guard_runner = bool(raw.get("verified_by_guard_runner"))
    authoritative = source == "codex_app_mcp_tool" and verified_by_guard_runner and not fallback_used
    list_apps_ok = bool(raw.get("list_apps_ok"))
    list_apps_repeat_ok = bool(raw.get("list_apps_repeat_ok"))
    get_app_state_ok = bool(raw.get("get_app_state_ok"))
    structured_events_found = bool(raw.get("structured_events_found"))
    interaction_ok = bool(raw.get("interaction_ok"))
    second_mouse_seen = bool(raw.get("second_mouse_verified"))
    failure_class = str(raw.get("failure_class") or "")
    if not authoritative:
        failure_class = failure_class or "non_authoritative_smoke"
    elif not age_fresh:
        failure_class = failure_class or "stale_native_smoke"
    elif not context_matches:
        failure_class = failure_class or "native_smoke_context_changed"
    elif not list_apps_ok:
        failure_class = failure_class or "native_list_apps_failed"
    elif not list_apps_repeat_ok:
        failure_class = failure_class or "native_list_apps_repeat_failed"
    elif not get_app_state_ok:
        failure_class = failure_class or "native_get_app_state_failed"
    elif not structured_events_found:
        failure_class = failure_class or "native_smoke_no_structured_events"
    elif not interaction_ok:
        failure_class = failure_class or "native_interaction_failed"
    elif not second_mouse_seen:
        failure_class = failure_class or "native_second_mouse_not_verified"
    appserver_rendezvous = authoritative and fresh and list_apps_ok
    second_mouse_verified = (
        appserver_rendezvous
        and list_apps_repeat_ok
        and get_app_state_ok
        and structured_events_found
        and interaction_ok
        and second_mouse_seen
    )
    operational = second_mouse_verified
    status = dict(raw)
    status.update(
        {
            "ok": operational,
            "fresh": fresh,
            "age_seconds": age_seconds,
            "authoritative": authoritative,
            "fallback_used": fallback_used,
            "verified_by_guard_runner": verified_by_guard_runner,
            "appserver_rendezvous": appserver_rendezvous,
            "operational": operational,
            "second_mouse_verified": second_mouse_verified,
            "failure_class": "" if operational else failure_class,
            "path": str(NATIVE_SMOKE_STATUS),
            "max_age_seconds": NATIVE_SMOKE_MAX_AGE_SECONDS,
            "age_fresh": age_fresh,
            "smoke_context_matches": context_matches,
            "current_smoke_context": current_context,
        }
    )
    return status


def _record_native_smoke_from_stdin() -> dict[str, Any]:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid native smoke JSON: {exc}") from exc
    if not isinstance(payload, dict):
        raise RuntimeError("native smoke JSON must be an object")
    payload.setdefault("recorded_at", int(time.time()))
    payload.setdefault("source", "codex_app_mcp_tool")
    payload.setdefault("fallback_used", False)
    payload["verified_by_guard_runner"] = False
    payload["recorder_pid"] = os.getpid()
    status = _native_smoke_status(payload)
    accepted_for_health = os.environ.get("CODEX_CU_ALLOW_UNVERIFIED_SMOKE_RECORD") == "1"
    status["accepted_for_health"] = accepted_for_health
    if accepted_for_health:
        _write_native_smoke(status)
    else:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        status["path"] = str(UNVERIFIED_NATIVE_SMOKE_STATUS)
        tmp = UNVERIFIED_NATIVE_SMOKE_STATUS.with_name(
            UNVERIFIED_NATIVE_SMOKE_STATUS.name + f".tmp-{os.getpid()}"
        )
        tmp.write_text(json.dumps(status, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        os.replace(tmp, UNVERIFIED_NATIVE_SMOKE_STATUS)
    return status


def _codex_exec_json_events(stdout: str) -> list[dict[str, Any]]:
    events: list[dict[str, Any]] = []
    for line in stdout.splitlines():
        stripped = line.strip()
        if not stripped.startswith("{"):
            continue
        try:
            payload = json.loads(stripped)
        except json.JSONDecodeError:
            continue
        if isinstance(payload, dict):
            events.append(payload)
    return events


def _completed_mcp_tool_count(events: list[dict[str, Any]], tool: str) -> int:
    count = 0
    for event in events:
        if event.get("type") != "item.completed":
            continue
        item = event.get("item")
        if not isinstance(item, dict):
            continue
        if (
            item.get("type") == "mcp_tool_call"
            and item.get("server") == "computer-use"
            and item.get("tool") == tool
            and item.get("status") == "completed"
        ):
            count += 1
    return count


def _mcp_tool_attempt_count(events: list[dict[str, Any]], tool: str) -> int:
    count = 0
    for event in events:
        if event.get("type") != "item.completed":
            continue
        item = event.get("item")
        if not isinstance(item, dict):
            continue
        if item.get("type") == "mcp_tool_call" and item.get("server") == "computer-use" and item.get("tool") == tool:
            count += 1
    return count


def _coordinate_click_attempt_count(events: list[dict[str, Any]]) -> int:
    count = 0
    for event in events:
        if event.get("type") != "item.completed":
            continue
        item = event.get("item")
        if not isinstance(item, dict):
            continue
        if item.get("type") != "mcp_tool_call" or item.get("server") != "computer-use" or item.get("tool") != "click":
            continue
        arguments = item.get("arguments")
        if isinstance(arguments, dict) and "x" in arguments and "y" in arguments:
            count += 1
    return count


def _press_key_event_matches(item: dict[str, Any], *, app: str, key: str) -> bool:
    if item.get("type") != "mcp_tool_call" or item.get("server") != "computer-use" or item.get("tool") != "press_key":
        return False
    arguments = item.get("arguments")
    return isinstance(arguments, dict) and arguments.get("app") == app and arguments.get("key") == key


def _press_key_completed_for(events: list[dict[str, Any]], *, app: str, key: str) -> bool:
    for event in events:
        if event.get("type") != "item.completed":
            continue
        item = event.get("item")
        if not isinstance(item, dict):
            continue
        if _press_key_event_matches(item, app=app, key=key) and item.get("status") == "completed":
            return True
    return False


def _press_key_reported_no_windows(events: list[dict[str, Any]], *, app: str, key: str) -> bool:
    return _press_key_reported_text(events, app=app, key=key, needle="noWindowsAvailable")


def _press_key_reported_text(events: list[dict[str, Any]], *, app: str, key: str, needle: str) -> bool:
    for event in events:
        if event.get("type") != "item.completed":
            continue
        item = event.get("item")
        if not isinstance(item, dict):
            continue
        if not _press_key_event_matches(item, app=app, key=key):
            continue
        result = item.get("result")
        if not isinstance(result, dict):
            continue
        content = result.get("content")
        if not isinstance(content, list):
            continue
        text = "\n".join(str(entry.get("text") or "") for entry in content if isinstance(entry, dict))
        if item.get("status") == "failed" and needle in text:
            return True
    return False


def _textedit_close_reported_no_windows(events: list[dict[str, Any]]) -> bool:
    return _press_key_reported_no_windows(events, app="com.apple.TextEdit", key="super+w")


def _agent_message_contains_line(events: list[dict[str, Any]], line: str) -> bool:
    for event in events:
        if event.get("type") != "item.completed":
            continue
        item = event.get("item")
        if not isinstance(item, dict) or item.get("type") != "agent_message":
            continue
        text = str(item.get("text") or "")
        if any(candidate.strip() == line for candidate in text.splitlines()):
            return True
    return False


def _mcp_tool_result_contains(
    events: list[dict[str, Any]], tool: str, needle: str, *, app: str | None = None
) -> bool:
    for event in events:
        if event.get("type") != "item.completed":
            continue
        item = event.get("item")
        if not isinstance(item, dict):
            continue
        if item.get("type") != "mcp_tool_call" or item.get("server") != "computer-use":
            continue
        if item.get("tool") != tool:
            continue
        if app is not None:
            arguments = item.get("arguments")
            if not isinstance(arguments, dict) or arguments.get("app") != app:
                continue
        result = item.get("result")
        if not isinstance(result, dict):
            continue
        content = result.get("content")
        if not isinstance(content, list):
            continue
        text = "\n".join(str(entry.get("text") or "") for entry in content if isinstance(entry, dict))
        if needle in text:
            return True
    return False


def _compact_stdout_tail(stdout: str, *, lines: int = 80, max_line_chars: int = 1200) -> str:
    compact_lines: list[str] = []
    for line in stdout.rstrip().splitlines()[-lines:]:
        if len(line) > max_line_chars:
            compact_lines.append(line[:max_line_chars] + "...<truncated>")
        else:
            compact_lines.append(line)
    return "\n".join(compact_lines)


def _cleanup_native_smoke_temp_files(smoke_file: Path) -> dict[str, Any]:
    removed: list[str] = []
    errors: list[str] = []
    candidates = sorted(smoke_file.parent.glob("codex-cu-native-smoke-*.txt"))
    if smoke_file not in candidates:
        candidates.append(smoke_file)
    for path in candidates:
        try:
            if path.exists():
                path.unlink()
                removed.append(str(path))
        except Exception as exc:
            errors.append(f"{path}: {exc}")
    return {
        "removed_count": len(removed),
        "current_removed": not smoke_file.exists(),
        "errors": errors,
    }


def _run_native_smoke() -> dict[str, Any]:
    """Run a fresh Codex-context native MCP smoke and persist only measured results."""
    _verify_openai_codex_app()
    if not OPENAI_CODEX_EXEC.is_file():
        raise RuntimeError(f"missing Codex executable: {OPENAI_CODEX_EXEC}")

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    started_at = int(time.time())
    calculator_sequence = "789"

    setup_error = ""
    try:
        subprocess.run(
            ["/usr/bin/open", "-g", "-a", "Calculator"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            timeout=5,
        )
        subprocess.run(
            ["/usr/bin/open", str(OPENAI_CODEX_APP)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            timeout=5,
        )
        time.sleep(1.0)
    except Exception as exc:
        setup_error = str(exc)

    success_line = "SUCCESS native_smoke list_apps_twice get_app_state_ok calculator_click_type_cleanup_ok"
    prompt = (
        "Use only native computer-use MCP tools and follow these numbered steps exactly. "
        "If the native computer-use tools are not exposed yet, use only Codex tool discovery/search to expose computer-use, then continue. "
        "Do not call command_execution, shell, or any non-computer-use GUI/control tool. "
        "Calculator may not be the frontmost app; target Calculator by bundle id com.apple.calculator instead of relying on the active app. "
        "The setup attempts to return focus to Codex before this run, so do not assume the active app is Calculator. "
        "1. Call computer-use/list_apps exactly twice. "
        "2. Call computer-use/get_app_state for Calculator using bundle id com.apple.calculator. "
        "3. Call computer-use/press_key with app com.apple.calculator and key Escape to clear any prior calculator value. "
        "4. Call computer-use/get_app_state for Calculator again. "
        "For this smoke, do not use x/y coordinate clicks; use only element_index clicks from get_app_state. "
        "5. Find the Calculator digit 7 button in get_app_state and call computer-use/click with app com.apple.calculator and that line's leading number as element_index. "
        "6. Find the Calculator digit 8 button in get_app_state and call computer-use/click with app com.apple.calculator and that line's leading number as element_index. "
        "7. Call computer-use/type_text with app com.apple.calculator and exactly this text: 9. "
        f"8. Call computer-use/get_app_state for Calculator again and confirm the display value contains {calculator_sequence}. "
        "9. After step 8 completes, call computer-use/press_key with app com.apple.calculator and key super+w to close Calculator. "
        "If step 9 returns App quit or noWindowsAvailable after the press_key call, treat that as cleanup complete and continue. "
        "Do not use shell commands, AppleScript, browser automation, Keyboard Maestro, screenshots, or any fallback. "
        "You must complete at least two computer-use/click calls and at least one computer-use/type_text call. "
        "Do not produce the final answer before step 9 is complete. "
        f"Finish with exactly one final line: {success_line} only if all 9 numbered steps completed; "
        "otherwise FAILURE and the precise failing step."
    )
    cmd = [str(OPENAI_CODEX_EXEC), "exec", "--skip-git-repo-check", "--json", prompt]
    timed_out = False
    try:
        result = subprocess.run(
            cmd,
            cwd=str(HOME / "Codex") if (HOME / "Codex").is_dir() else str(HOME),
            input="",
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            timeout=NATIVE_SMOKE_TIMEOUT_SECONDS,
        )
        stdout = result.stdout or ""
        stderr = result.stderr or ""
        returncode = result.returncode
    except subprocess.TimeoutExpired as exc:
        timed_out = True
        stdout = (exc.stdout or "") if isinstance(exc.stdout, str) else ""
        stderr = (exc.stderr or "") if isinstance(exc.stderr, str) else ""
        returncode = 124
    smoke_cleanup = _cleanup_native_smoke_temp_files(
        Path(tempfile.gettempdir()) / f"codex-cu-native-smoke-{started_at}-{os.getpid()}.txt"
    )

    events = _codex_exec_json_events(stdout)
    stdout_lines = [line.strip() for line in stdout.splitlines() if line.strip()]
    unstructured_stdout_lines = max(0, len(stdout_lines) - len(events))
    structured_events_found = bool(events) and unstructured_stdout_lines == 0
    command_execution_count = sum(
        1
        for event in events
        if isinstance(event.get("item"), dict) and event["item"].get("type") == "command_execution"
    )
    first_computer_use_mcp_index = next(
        (
            idx
            for idx, event in enumerate(events)
            if isinstance(event.get("item"), dict)
            and event["item"].get("type") == "mcp_tool_call"
            and event["item"].get("server") == "computer-use"
        ),
        None,
    )
    allowed_discovery_item_types = {"web_search", "tool_search"}

    def _event_item_summary(event: dict[str, Any]) -> dict[str, Any]:
        item = event["item"]
        return {
            "type": item.get("type"),
            "server": item.get("server"),
            "tool": item.get("tool"),
            "status": item.get("status"),
        }

    tool_discovery_events = [
        _event_item_summary(event)
        for idx, event in enumerate(events)
        if isinstance(event.get("item"), dict)
        and event["item"].get("type") in allowed_discovery_item_types
        and (first_computer_use_mcp_index is None or idx < first_computer_use_mcp_index)
    ]
    non_native_tool_calls = [
        _event_item_summary(event)
        for idx, event in enumerate(events)
        if isinstance(event.get("item"), dict)
        and event["item"].get("type") not in {"agent_message", "mcp_tool_call"}
        and not (
            event["item"].get("type") in allowed_discovery_item_types
            and (first_computer_use_mcp_index is None or idx < first_computer_use_mcp_index)
        )
    ]
    non_computer_use_mcp_calls = [
        {
            "server": event["item"].get("server"),
            "tool": event["item"].get("tool"),
            "status": event["item"].get("status"),
        }
        for event in events
        if isinstance(event.get("item"), dict)
        and event["item"].get("type") == "mcp_tool_call"
        and event["item"].get("server") != "computer-use"
    ]
    list_apps_completed = _completed_mcp_tool_count(events, "list_apps")
    get_app_state_completed = _completed_mcp_tool_count(events, "get_app_state")
    click_completed = _completed_mcp_tool_count(events, "click")
    coordinate_click_attempts = _coordinate_click_attempt_count(events)
    type_text_completed = _completed_mcp_tool_count(events, "type_text") >= 1
    press_key_completed = _completed_mcp_tool_count(events, "press_key")
    press_key_attempted = _mcp_tool_attempt_count(events, "press_key")
    calculator_close_completed = _press_key_completed_for(events, app="com.apple.calculator", key="super+w")
    calculator_close_no_windows = _press_key_reported_no_windows(events, app="com.apple.calculator", key="super+w")
    calculator_close_app_quit = _press_key_reported_text(
        events, app="com.apple.calculator", key="super+w", needle="App quit"
    )
    calculator_close_ok = calculator_close_completed or calculator_close_no_windows or calculator_close_app_quit
    cleanup_keypress_ok = calculator_close_ok
    success_marker = _agent_message_contains_line(events, success_line)
    calculator_display_verified = _mcp_tool_result_contains(
        events, "get_app_state", calculator_sequence, app="com.apple.calculator"
    ) or _mcp_tool_result_contains(events, "type_text", calculator_sequence, app="com.apple.calculator")
    calculator_click_verified = click_completed >= 2 and calculator_display_verified
    target_frontmost_seen = _mcp_tool_result_contains(events, "list_apps", "com.apple.calculator [frontmost")
    fallback_patterns = (
        r"(?im)^\s*(?:/usr/local/bin/|/opt/homebrew/bin/|/usr/bin/)?cliclick\b",
        r"(?im)^\s*(?:/usr/sbin/|/usr/bin/)?screencapture\b",
        r"(?im)^\s*(?:/usr/bin/)?osascript\b",
        r"mcp: keyboard-maestro/",
        r"mcp: browser-use/",
        r"mcp: browser/",
    )
    fallback_used = (
        command_execution_count > 0
        or bool(non_native_tool_calls)
        or bool(non_computer_use_mcp_calls)
        or any(re.search(pattern, stdout) for pattern in fallback_patterns)
    )
    failure_class = ""
    error = ""
    if timed_out:
        failure_class = "native_smoke_timeout"
        error = f"codex exec timed out after {NATIVE_SMOKE_TIMEOUT_SECONDS}s"
    elif returncode != 0:
        failure_class = "native_smoke_codex_exec_failed"
        error = f"codex exec exited with {returncode}"
    elif not structured_events_found:
        failure_class = "native_smoke_no_structured_events"
        error = (
            "codex exec --json produced no structured events"
            if not events
            else f"codex exec --json stdout contained {unstructured_stdout_lines} unstructured lines"
        )
    elif fallback_used:
        failure_class = "native_fallback_used"
        error = (
            f"non-native tool usage detected: command_execution_count={command_execution_count} "
            f"non_native_tool_calls={non_native_tool_calls} "
            f"non_computer_use_mcp_calls={non_computer_use_mcp_calls}"
        )
    elif list_apps_completed < 2:
        failure_class = "native_list_apps_repeat_failed"
        error = f"list_apps completed {list_apps_completed} times"
    elif get_app_state_completed < 2:
        failure_class = "native_get_app_state_failed"
        error = f"get_app_state completed {get_app_state_completed} times"
    elif coordinate_click_attempts:
        failure_class = "native_coordinate_click_used"
        error = f"coordinate_click_attempts={coordinate_click_attempts}"
    elif click_completed < 2 or not calculator_click_verified:
        failure_class = "native_click_failed"
        error = f"click_completed={click_completed} calculator_click_verified={calculator_click_verified}"
    elif not (type_text_completed and calculator_display_verified and cleanup_keypress_ok and success_marker):
        failure_class = "native_interaction_failed"
        error = (
            f"type_text={type_text_completed} press_key_completed={press_key_completed} "
            f"press_key_attempted={press_key_attempted} cleanup_keypress_ok={cleanup_keypress_ok} "
            f"success_marker={success_marker} calculator_display_verified={calculator_display_verified}"
        )
    if setup_error and not error:
        error = setup_error

    payload = {
        "recorded_at": int(time.time()),
        "started_at": started_at,
        "source": "codex_app_mcp_tool",
        "runner": "codex-computer-use-guard run-native-smoke",
        "smoke_context": _current_native_smoke_context(),
        "verified_by_guard_runner": True,
        "fallback_used": fallback_used,
        "codex_exec": str(OPENAI_CODEX_EXEC),
        "codex_exec_exit_code": returncode,
        "codex_exec_timed_out": timed_out,
        "structured_events_found": structured_events_found,
        "unstructured_stdout_lines": unstructured_stdout_lines,
        "command_execution_count": command_execution_count,
        "tool_discovery_events": tool_discovery_events,
        "non_native_tool_calls": non_native_tool_calls,
        "non_computer_use_mcp_calls": non_computer_use_mcp_calls,
        "list_apps_completed": list_apps_completed,
        "get_app_state_completed": get_app_state_completed,
        "click_completed": click_completed,
        "coordinate_click_attempts": coordinate_click_attempts,
        "calculator_click_verified": calculator_click_verified,
        "calculator_display_verified": calculator_display_verified,
        "type_text_completed": type_text_completed,
        "press_key_completed": press_key_completed,
        "press_key_attempted": press_key_attempted,
        "calculator_close_completed": calculator_close_completed,
        "calculator_close_no_windows": calculator_close_no_windows,
        "calculator_close_app_quit": calculator_close_app_quit,
        "calculator_close_ok": calculator_close_ok,
        "target_frontmost_seen": target_frontmost_seen,
        "target_not_frontmost_verified": not target_frontmost_seen,
        "cleanup_keypress_ok": cleanup_keypress_ok,
        "success_marker": success_marker,
        "interaction_token": calculator_sequence,
        "smoke_target": "com.apple.calculator",
        "smoke_cleanup": smoke_cleanup,
        "list_apps_ok": list_apps_completed >= 1,
        "list_apps_repeat_ok": list_apps_completed >= 2,
        "get_app_state_ok": get_app_state_completed >= 2,
        "interaction_ok": (
            click_completed >= 2
            and calculator_click_verified
            and calculator_display_verified
            and type_text_completed
            and cleanup_keypress_ok
            and success_marker
        ),
        "second_mouse_verified": click_completed >= 2 and calculator_click_verified and calculator_display_verified,
        "failure_class": failure_class,
        "error": error,
        "stdout_tail": _compact_stdout_tail(stdout),
        "stderr_tail": _compact_stdout_tail(stderr, lines=40),
    }
    status = _native_smoke_status(payload)
    _write_native_smoke(status)
    cleanup_stale_mcp_clients(kill_duplicates=False)
    return status


def _bootstrap_script() -> str:
    return f"""#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import shutil
import sys
import time
from pathlib import Path

MAIN = Path({str(MAIN_GUARD)!r})
BACKUP = Path({str(GUARD_BACKUP)!r})
LOG = Path({str(CODEX_HOME / "logs" / "computer-use-guard.bootstrap.log.jsonl")!r})


def log(level: str, message: str, **fields: object) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        payload = {{"ts": int(time.time()), "level": level, "message": message}}
        if fields:
            payload["fields"] = fields
        with LOG.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(payload, ensure_ascii=True) + "\\n")
    except Exception:
        pass


def restore_if_needed() -> None:
    needs_restore = (not MAIN.is_file()) or (MAIN.is_file() and MAIN.stat().st_size < 1000)
    if needs_restore and BACKUP.is_file():
        MAIN.parent.mkdir(parents=True, exist_ok=True)
        tmp = MAIN.with_name(MAIN.name + f".restore-{{os.getpid()}}")
        shutil.copy2(BACKUP, tmp)
        os.chmod(tmp, 0o700)
        os.replace(tmp, MAIN)
        log("info", "restored computer-use guard from bootstrap backup", main=str(MAIN), backup=str(BACKUP))
    if MAIN.is_file() and not os.access(MAIN, os.X_OK):
        os.chmod(MAIN, 0o700)
        log("info", "restored computer-use guard executable bit", main=str(MAIN))


restore_if_needed()
if not MAIN.is_file():
    log("error", "computer-use guard missing and bootstrap backup unavailable", main=str(MAIN), backup=str(BACKUP))
    raise SystemExit(127)

os.execv(str(MAIN), [str(MAIN), *sys.argv[1:]])
"""


def _write_bootstrap_assets() -> bool:
    changed = False
    (CODEX_HOME / "logs").mkdir(parents=True, exist_ok=True)
    BOOTSTRAP_DIR.mkdir(parents=True, exist_ok=True)
    source = _self_path()
    if source.is_file():
        try:
            if not GUARD_BACKUP.exists() or source.read_bytes() != GUARD_BACKUP.read_bytes():
                tmp = GUARD_BACKUP.with_name(GUARD_BACKUP.name + f".tmp-{os.getpid()}")
                shutil.copy2(source, tmp)
                os.chmod(tmp, 0o700)
                os.replace(tmp, GUARD_BACKUP)
                changed = True
        except Exception:
            pass
    bootstrap = _bootstrap_script()
    current = BOOTSTRAP.read_text(encoding="utf-8") if BOOTSTRAP.exists() else ""
    if current != bootstrap:
        tmp = BOOTSTRAP.with_name(BOOTSTRAP.name + f".tmp-{os.getpid()}")
        tmp.write_text(bootstrap, encoding="utf-8")
        os.chmod(tmp, 0o700)
        os.replace(tmp, BOOTSTRAP)
        changed = True
    elif not os.access(BOOTSTRAP, os.X_OK):
        os.chmod(BOOTSTRAP, 0o700)
        changed = True
    return changed


def _launch_agent_payload() -> dict[str, Any]:
    return {
        "Label": LAUNCH_AGENT_LABEL,
        "EnvironmentVariables": {"CODEX_CU_CODEX_APP": str(OPENAI_CODEX_APP)},
        "ProgramArguments": [str(BOOTSTRAP), "ensure-config", "--quiet"],
        "RunAtLoad": True,
        "StartInterval": LAUNCH_AGENT_START_INTERVAL_SECONDS,
        "StandardErrorPath": str(CODEX_HOME / "logs" / "computer-use-guard.launchd.err.log"),
        "StandardOutPath": str(CODEX_HOME / "logs" / "computer-use-guard.launchd.out.log"),
        "WatchPaths": [
            str(CONFIG),
            str(CODEX_HOME),
            str(BUNDLED_MARKETPLACE),
            str(PATCHED_BUNDLED_MARKETPLACE),
            str(CODEX_HOME / "plugins" / "cache" / "openai-bundled"),
        ],
    }


def _write_launch_agent() -> bool:
    desired = _launch_agent_payload()
    current: dict[str, Any] | None = None
    if LAUNCH_AGENT.exists():
        try:
            with LAUNCH_AGENT.open("rb") as fh:
                current = plistlib.load(fh)
        except Exception:
            current = None
    if current == desired:
        return False
    LAUNCH_AGENT.parent.mkdir(parents=True, exist_ok=True)
    tmp = LAUNCH_AGENT.with_name(LAUNCH_AGENT.name + f".tmp-{os.getpid()}")
    with tmp.open("wb") as fh:
        plistlib.dump(desired, fh, sort_keys=True)
    os.replace(tmp, LAUNCH_AGENT)
    return True


def _launch_agent_config_ok() -> bool:
    if not LAUNCH_AGENT.is_file():
        return False
    try:
        with LAUNCH_AGENT.open("rb") as fh:
            current = plistlib.load(fh)
    except Exception:
        return False
    return current == _launch_agent_payload()


def _launch_agent_loaded() -> bool:
    try:
        result = _run_capture(
            ["/bin/launchctl", "print", f"gui/{os.getuid()}/{LAUNCH_AGENT_LABEL}"],
            timeout=2,
        )
        return result.returncode == 0
    except Exception:
        return False


def _launch_agent_loaded_for(label: str) -> bool:
    try:
        result = _run_capture(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"], timeout=2)
        return result.returncode == 0
    except Exception:
        return False


def _legacy_launch_agent_labels() -> list[str]:
    return sorted(set(LEGACY_LAUNCH_AGENT_LABELS))


def _cleanup_legacy_launch_agents() -> bool:
    changed = False
    for label in _legacy_launch_agent_labels():
        if _launch_agent_loaded_for(label):
            try:
                subprocess.run(
                    ["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{label}"],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=2,
                )
                changed = True
            except Exception:
                pass
        path = HOME / "Library" / "LaunchAgents" / f"{label}.plist"
        if path.exists():
            try:
                path.unlink()
                changed = True
            except Exception as exc:  # noqa: BLE001
                _log("error", "failed to remove legacy computer-use guard LaunchAgent", label=label, error=str(exc))
    return changed


def ensure_launch_agent() -> tuple[bool, bool]:
    bootstrap_changed = _write_bootstrap_assets()
    plist_changed = _write_launch_agent()
    loaded = _launch_agent_loaded()
    if loaded and not plist_changed:
        legacy_changed = _cleanup_legacy_launch_agents()
        return bootstrap_changed or legacy_changed, True
    if loaded and plist_changed:
        try:
            subprocess.run(
                ["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{LAUNCH_AGENT_LABEL}"],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=2,
            )
        except Exception:
            pass
        loaded = False
    if not loaded:
        try:
            result = subprocess.run(
                ["/bin/launchctl", "bootstrap", f"gui/{os.getuid()}", str(LAUNCH_AGENT)],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=2,
            )
            loaded = result.returncode == 0 or _launch_agent_loaded()
        except Exception:
            loaded = _launch_agent_loaded()
    legacy_changed = _cleanup_legacy_launch_agents() if loaded else False
    return bootstrap_changed or plist_changed or legacy_changed, loaded


def _dialog_autopilot(command: str) -> dict[str, Any]:
    if not DIALOG_AUTOPILOT.is_file():
        return {"ok": False, "missing": True, "path": str(DIALOG_AUTOPILOT)}
    try:
        result = _run_capture([str(DIALOG_AUTOPILOT), command, "--json"], timeout=8)
    except Exception as exc:  # noqa: BLE001
        return {"ok": False, "error": str(exc), "path": str(DIALOG_AUTOPILOT)}
    try:
        payload = json.loads(result.stdout)
    except Exception:
        payload = {"ok": False, "error": result.stdout[-800:], "path": str(DIALOG_AUTOPILOT)}
    if not isinstance(payload, dict):
        payload = {"ok": False, "error": "non-object dialog autopilot response", "path": str(DIALOG_AUTOPILOT)}
    payload.setdefault("path", str(DIALOG_AUTOPILOT))
    payload.setdefault("returncode", result.returncode)
    return payload


def ensure_dialog_autopilot() -> dict[str, Any]:
    return _dialog_autopilot("install")


def dialog_autopilot_status() -> dict[str, Any]:
    return _dialog_autopilot("status")


def _load_plugin_manifest(source: Path) -> dict[str, Any]:
    path = source / ".codex-plugin" / "plugin.json"
    with path.open("r", encoding="utf-8-sig") as fh:
        payload = json.load(fh)
    if payload.get("name") != "computer-use":
        raise RuntimeError(f"unexpected plugin name in {path}")
    version = str(payload.get("version") or "").strip()
    if not version:
        raise RuntimeError(f"missing computer-use plugin version in {path}")
    if payload.get("mcpServers") != "./.mcp.json":
        raise RuntimeError(f"unexpected computer-use mcpServers in {path}")
    return payload


def _marketplace_plugin_names(marketplace: Path) -> set[str]:
    path = marketplace / ".agents" / "plugins" / "marketplace.json"
    try:
        with path.open("r", encoding="utf-8-sig") as fh:
            payload = json.load(fh)
    except Exception:
        return set()
    plugins = payload.get("plugins") if isinstance(payload, dict) else payload
    if not isinstance(plugins, list):
        return set()
    names: set[str] = set()
    for item in plugins:
        if isinstance(item, str):
            name = item
        elif isinstance(item, dict):
            name = str(item.get("name") or item.get("id") or item.get("pluginId") or "")
        else:
            name = ""
        if name:
            names.add(name)
    return names


def _plugin_local_mcp_wrapper_path(plugin_root: Path) -> Path:
    return plugin_root / PLUGIN_MCP_WRAPPER


def _plugin_local_mcp_wrapper_text() -> str:
    return (
        "#!/usr/bin/env bash\n"
        "set -euo pipefail\n"
        'exec "$HOME/.codex/bin/codex-computer-use-native-launcher" "$@"\n'
    )


def _native_launcher_text() -> str:
    return """#!/usr/bin/env bash
set -euo pipefail

guard_repair_ok=1
if [[ "${CODEX_CU_LAUNCHER_SKIP_GUARD:-}" != "1" ]]; then
  if ! "$HOME/.codex/bin/codex-computer-use-guard" ensure-config --quiet >/dev/null 2>&1; then
    guard_repair_ok=0
    echo "codex-computer-use-native-launcher: ensure-config failed; skipping stale cache candidates" >&2
  fi
fi

codex_app="${CODEX_CU_CODEX_APP:-}"
if [[ -z "$codex_app" && -r "$HOME/.codex/state/computer-use-guard/codex-app-path" ]]; then
  IFS= read -r codex_app < "$HOME/.codex/state/computer-use-guard/codex-app-path" || true
fi
codex_app="${codex_app:-/Applications/Codex.app}"
native_candidates=(
  "$HOME/.codex/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient"
  "$HOME/.codex/plugins/marketplaces/openai-bundled/plugins/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient"
  "$HOME/.codex/plugins/cache/openai-bundled/computer-use"/*/"Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient"
  "$codex_app/Contents/Resources/plugins/openai-bundled/plugins/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient"
)

for native_binary in "${native_candidates[@]}"; do
  if [[ "$guard_repair_ok" != "1" && "$native_binary" == "$HOME/.codex/plugins/cache/openai-bundled/computer-use"* ]]; then
    continue
  fi
  if [[ -x "$native_binary" ]]; then
    exec "$native_binary" "$@"
  fi
done

echo "no executable native Computer Use client found" >&2
exit 127
"""


def _notify_wrapper_text() -> str:
    return f"""#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CODEX_HOME = HOME / ".codex"
LOG = CODEX_HOME / "logs" / "computer-use-notify.log.jsonl"
CODEX_APP = Path(os.environ.get("CODEX_CU_CODEX_APP", "/Applications/Codex.app")).expanduser()
NATIVE_BINARY_CANDIDATES = [
    CODEX_HOME / "plugins" / "marketplaces" / "openai-bundled" / "plugins" / "computer-use" / "Codex Computer Use.app" / "Contents" / "SharedSupport" / "SkyComputerUseClient.app" / "Contents" / "MacOS" / "SkyComputerUseClient",
    CODEX_APP / "Contents" / "Resources" / "plugins" / "openai-bundled" / "plugins" / "computer-use" / "Codex Computer Use.app" / "Contents" / "SharedSupport" / "SkyComputerUseClient.app" / "Contents" / "MacOS" / "SkyComputerUseClient",
    CODEX_HOME / "computer-use" / "Codex Computer Use.app" / "Contents" / "SharedSupport" / "SkyComputerUseClient.app" / "Contents" / "MacOS" / "SkyComputerUseClient",
]
TIMEOUT_SECONDS = float(os.environ.get("CODEX_CU_NOTIFY_TIMEOUT", "4"))


def log(level: str, message: str, **fields: object) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        payload = {{"ts": int(time.time()), "level": level, "message": message}}
        if fields:
            payload["fields"] = fields
        with LOG.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(payload, ensure_ascii=True) + "\\n")
    except Exception:
        pass


def cleanup_native_turn_ended() -> list[int]:
    killed: list[int] = []
    try:
        result = subprocess.run(
            ["/bin/ps", "-axo", "pid=,command="],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=2,
        )
    except Exception:
        return killed
    needles = [str(path) + " turn-ended" for path in NATIVE_BINARY_CANDIDATES]
    for raw_line in result.stdout.splitlines():
        line = raw_line.strip()
        if not line or not any(needle in line for needle in needles):
            continue
        pid_text, _, _command = line.partition(" ")
        try:
            pid = int(pid_text)
        except ValueError:
            continue
        if pid == os.getpid():
            continue
        try:
            os.kill(pid, signal.SIGKILL)
            killed.append(pid)
        except Exception:
            pass
    return killed


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in {{"--help", "-h", "help"}}:
        print("USAGE: codex-computer-use-notify turn-ended [payload]")
        return 0
    native_binary = next((path for path in NATIVE_BINARY_CANDIDATES if path.is_file() and os.access(path, os.X_OK)), None)
    if native_binary is None:
        log("info", "native notify binary missing; ignoring", candidates=[str(path) for path in NATIVE_BINARY_CANDIDATES], argv=sys.argv[1:])
        cleanup_native_turn_ended()
        return 0
    proc = subprocess.Popen(
        [str(native_binary), *sys.argv[1:]],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    try:
        proc.wait(timeout=TIMEOUT_SECONDS)
        if proc.returncode not in (0, None):
            log("info", "native notify exited non-zero", returncode=proc.returncode, argv=sys.argv[1:])
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
        log("info", "native notify timed out and was killed", timeout=TIMEOUT_SECONDS, argv=sys.argv[1:])
    killed = cleanup_native_turn_ended()
    if killed:
        log("info", "cleaned native notify stragglers", killed=killed, argv=sys.argv[1:])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
"""


def _mcp_command_path() -> Path:
    return COMPUTER_USE_NATIVE_LAUNCHER if COMPUTER_USE_NATIVE_LAUNCHER.is_file() else _runtime_binary_path()


def ensure_broker_backup() -> bool:
    """Keep the diagnostic native-only broker restorable across accidental deletion."""
    changed = False
    BOOTSTRAP_DIR.mkdir(parents=True, exist_ok=True)
    if COMPUTER_USE_BROKER.is_file():
        if not BROKER_BACKUP.exists() or COMPUTER_USE_BROKER.read_bytes() != BROKER_BACKUP.read_bytes():
            tmp = BROKER_BACKUP.with_name(BROKER_BACKUP.name + f".tmp-{os.getpid()}")
            shutil.copy2(COMPUTER_USE_BROKER, tmp)
            os.chmod(tmp, 0o700)
            os.replace(tmp, BROKER_BACKUP)
            changed = True
        if not os.access(COMPUTER_USE_BROKER, os.X_OK):
            os.chmod(COMPUTER_USE_BROKER, 0o700)
            changed = True
        return changed
    if BROKER_BACKUP.is_file():
        COMPUTER_USE_BROKER.parent.mkdir(parents=True, exist_ok=True)
        tmp = COMPUTER_USE_BROKER.with_name(COMPUTER_USE_BROKER.name + f".tmp-{os.getpid()}")
        shutil.copy2(BROKER_BACKUP, tmp)
        os.chmod(tmp, 0o700)
        os.replace(tmp, COMPUTER_USE_BROKER)
        return True
    return changed


def ensure_native_launcher() -> bool:
    """Keep the MCP entrypoint as an exec-preserving native launcher."""
    return _ensure_text_file(COMPUTER_USE_NATIVE_LAUNCHER, _native_launcher_text(), executable=True)


def _native_launcher_ok() -> bool:
    return (
        COMPUTER_USE_NATIVE_LAUNCHER.is_file()
        and os.access(COMPUTER_USE_NATIVE_LAUNCHER, os.X_OK)
        and COMPUTER_USE_NATIVE_LAUNCHER.read_text(encoding="utf-8") == _native_launcher_text()
    )


def ensure_notify_wrapper() -> bool:
    """Keep Codex turn-ended notifications from leaving native helper processes behind."""
    return _ensure_text_file(COMPUTER_USE_NOTIFY, _notify_wrapper_text(), executable=True)


def _notify_wrapper_ok() -> bool:
    return (
        COMPUTER_USE_NOTIFY.is_file()
        and os.access(COMPUTER_USE_NOTIFY, os.X_OK)
        and COMPUTER_USE_NOTIFY.read_text(encoding="utf-8") == _notify_wrapper_text()
    )


def ensure_plugin_local_mcp_wrapper(plugin_root: Path) -> bool:
    """Keep marketplace plugin loading away from the unpatched bundled binary."""
    changed = False
    wrapper = _plugin_local_mcp_wrapper_path(plugin_root)
    desired_wrapper = _plugin_local_mcp_wrapper_text()
    current_wrapper = wrapper.read_text(encoding="utf-8") if wrapper.exists() else ""
    if current_wrapper != desired_wrapper:
        tmp = wrapper.with_name(wrapper.name + f".tmp-{os.getpid()}")
        tmp.write_text(desired_wrapper, encoding="utf-8")
        os.chmod(tmp, 0o700)
        os.replace(tmp, wrapper)
        changed = True
    elif not os.access(wrapper, os.X_OK):
        os.chmod(wrapper, 0o700)
        changed = True

    mcp_path = plugin_root / ".mcp.json"
    desired_server = {
        "command": f"./{PLUGIN_MCP_WRAPPER}",
        "args": ["mcp"],
        "cwd": ".",
    }
    desired = {"mcpServers": {"computer-use": desired_server}}
    try:
        current = json.loads(mcp_path.read_text(encoding="utf-8-sig"))
    except Exception:
        current = None
    if current != desired:
        tmp = mcp_path.with_name(mcp_path.name + f".tmp-{os.getpid()}")
        tmp.write_text(json.dumps(desired, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        os.replace(tmp, mcp_path)
        changed = True
    return changed


def _plugin_local_mcp_wrapper_ok(plugin_root: Path) -> bool:
    wrapper = _plugin_local_mcp_wrapper_path(plugin_root)
    if not wrapper.is_file() or not os.access(wrapper, os.X_OK):
        return False
    try:
        if wrapper.read_text(encoding="utf-8") != _plugin_local_mcp_wrapper_text():
            return False
        payload = json.loads((plugin_root / ".mcp.json").read_text(encoding="utf-8-sig"))
    except Exception:
        return False
    server = ((payload.get("mcpServers") or {}).get("computer-use") or {})
    return server == {
        "command": f"./{PLUGIN_MCP_WRAPPER}",
        "args": ["mcp"],
        "cwd": ".",
    }


def _plugin_local_mcp_wrapper_runtime_probe(plugin_root: Path) -> tuple[bool, str]:
    wrapper = _plugin_local_mcp_wrapper_path(plugin_root)
    if not wrapper.is_file():
        return False, f"missing plugin wrapper: {wrapper}"
    try:
        result = _run_capture([str(wrapper), "--help"], timeout=10, env=_launcher_probe_env())
    except Exception as exc:  # noqa: BLE001
        return False, str(exc)
    if result.returncode == 0:
        return True, ""
    tail = "\n".join(result.stdout.rstrip().splitlines()[-6:])
    return False, tail or f"plugin wrapper exited with {result.returncode}"


def _bundled_marketplace_copy_ok(marketplace: Path) -> bool:
    names = _marketplace_plugin_names(marketplace)
    plugin = marketplace / "plugins" / "computer-use"
    return (
        "computer-use" in names
        and (plugin / ".codex-plugin" / "plugin.json").is_file()
        and (plugin / ".mcp.json").is_file()
        and _plugin_local_mcp_wrapper_ok(plugin)
        and _plugin_skill_suppressed_ok(plugin)
    )


def _bundled_marketplace_version_ok(marketplace: Path, expected_version: str) -> bool:
    path = marketplace / "plugins" / "computer-use" / ".codex-plugin" / "plugin.json"
    try:
        with path.open("r", encoding="utf-8-sig") as fh:
            payload = json.load(fh)
    except Exception:
        return False
    return payload.get("name") == "computer-use" and str(payload.get("version") or "") == expected_version


def _computer_use_manifest_without_skills(source_manifest: Path) -> str | None:
    try:
        with source_manifest.open("r", encoding="utf-8-sig") as fh:
            payload = json.load(fh)
    except Exception:
        return None
    if not isinstance(payload, dict):
        return None
    payload.pop("skills", None)
    return json.dumps(payload, indent=2, sort_keys=False) + "\n"


def _mirror_bundled_marketplace(source: Path, dest: Path, *, patch_computer_use: bool) -> bool:
    """Mirror a bundled marketplace and optionally patch its Computer Use MCP entry."""
    source_manifest = source / ".agents" / "plugins" / "marketplace.json"
    if not source_manifest.is_file():
        return False
    changed = False
    dest_manifest = dest / ".agents" / "plugins" / "marketplace.json"
    dest_manifest.parent.mkdir(parents=True, exist_ok=True)
    if not dest_manifest.exists() or source_manifest.read_bytes() != dest_manifest.read_bytes():
        tmp = dest_manifest.with_name(dest_manifest.name + f".tmp-{os.getpid()}")
        shutil.copy2(source_manifest, tmp)
        os.replace(tmp, dest_manifest)
        changed = True
    for plugin_name in sorted(_marketplace_plugin_names(source)):
        source_plugin = source / "plugins" / plugin_name
        dest_plugin = dest / "plugins" / plugin_name
        if not source_plugin.is_dir():
            continue
        source_plugin_manifest = source_plugin / ".codex-plugin" / "plugin.json"
        dest_plugin_manifest = dest_plugin / ".codex-plugin" / "plugin.json"
        if plugin_name == "computer-use":
            desired_manifest = _computer_use_manifest_without_skills(source_plugin_manifest)
            manifest_needs_copy = (
                not dest_plugin_manifest.is_file()
                or desired_manifest is None
                or dest_plugin_manifest.read_text(encoding="utf-8", errors="replace") != desired_manifest
            )
        else:
            manifest_needs_copy = (
                not dest_plugin_manifest.is_file()
                or (
                    source_plugin_manifest.is_file()
                    and source_plugin_manifest.read_bytes() != dest_plugin_manifest.read_bytes()
                )
            )
        if manifest_needs_copy:
            tmp = dest_plugin.with_name(dest_plugin.name + f".tmp-{os.getpid()}")
            if tmp.exists():
                shutil.rmtree(tmp)
            tmp.parent.mkdir(parents=True, exist_ok=True)
            subprocess.run(["/usr/bin/ditto", str(source_plugin), str(tmp)], check=True)
            if dest_plugin.exists():
                shutil.rmtree(dest_plugin)
            tmp.rename(dest_plugin)
            changed = True
        if plugin_name == "computer-use" and dest_plugin.is_dir():
            if patch_computer_use:
                changed = ensure_plugin_local_mcp_wrapper(dest_plugin) or changed
            changed = ensure_plugin_skill_suppressed(dest_plugin) or changed
    return changed


def _patched_bundled_marketplace_ok() -> bool:
    return _bundled_marketplace_copy_ok(PATCHED_BUNDLED_MARKETPLACE)


def _tmp_bundled_marketplace_ok() -> bool:
    return _bundled_marketplace_copy_ok(TMP_BUNDLED_MARKETPLACE)


def ensure_patched_bundled_marketplace() -> bool:
    """Repair the stable local marketplace Codex should use for plugin loading."""
    return _mirror_bundled_marketplace(BUNDLED_MARKETPLACE, PATCHED_BUNDLED_MARKETPLACE, patch_computer_use=True)


def ensure_tmp_bundled_marketplace() -> bool:
    """Repair Codex's local bundled-marketplace copy used during app startup."""
    source = PATCHED_BUNDLED_MARKETPLACE if PATCHED_BUNDLED_MARKETPLACE.is_dir() else BUNDLED_MARKETPLACE
    return _mirror_bundled_marketplace(source, TMP_BUNDLED_MARKETPLACE, patch_computer_use=True)



def _processes_matching(needle: str) -> list[tuple[int, int, str]]:
    try:
        result = _run_capture(["/bin/ps", "-axo", "pid=,ppid=,command="], timeout=2)
    except Exception:
        return []
    matches: list[tuple[int, int, str]] = []
    for line in result.stdout.splitlines():
        stripped = line.strip()
        if not stripped or needle not in stripped:
            continue
        parts = stripped.split(None, 2)
        if len(parts) < 3:
            continue
        try:
            pid = int(parts[0])
            ppid = int(parts[1])
        except ValueError:
            continue
        command = parts[2]
        matches.append((pid, ppid, command))
    return matches


def _kill_pid(pid: int) -> bool:
    if pid == os.getpid():
        return False
    def alive() -> bool:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        return True

    try:
        os.kill(pid, signal.SIGTERM)
    except Exception:
        return False
    for _ in range(10):
        if not alive():
            return True
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    except Exception:
        return False
    for _ in range(10):
        if not alive():
            return True
        time.sleep(0.1)
    return not alive()


def cleanup_stale_mcp_clients(
    *,
    kill_duplicates: bool = False,
    respect_duplicate_grace: bool = True,
    kill_orphans: bool = True,
) -> dict[str, Any]:
    """Keep stale native MCP clients from poisoning later Codex tool sessions.

    Codex can leave old SkyComputerUseClient MCP servers behind after a tool
    timeout or thread interruption. Multiple resident MCP clients under one
    Codex app-server parent can also be legitimate when several Codex threads
    are open, so this function only removes orphaned clients by default. Full
    ensure is allowed to collapse duplicate groups by keeping the newest client
    per parent, because duplicate native transports have proven to make fresh
    Computer Use sessions unreliable across restarts.
    """
    matches = [
        (pid, ppid, command)
        for pid, ppid, command in _processes_matching("SkyComputerUseClient")
        if command.endswith("SkyComputerUseClient mcp") or "SkyComputerUseClient mcp" in command
    ]
    killed: list[int] = []
    def parent_alive(ppid: int) -> bool:
        try:
            os.kill(ppid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        return True

    for pid, ppid, _command in matches:
        if kill_orphans and (ppid in {0, 1} or (ppid and not parent_alive(ppid))):
            if _kill_pid(pid):
                killed.append(pid)
    skipped_young: list[int] = []
    if kill_duplicates and len(matches) > 1:
        by_parent: dict[int, list[tuple[int, str]]] = {}
        for pid, ppid, command in matches:
            by_parent.setdefault(ppid, []).append((pid, command))
        for _ppid, group in by_parent.items():
            if len(group) <= 1:
                continue
            ages = {pid: _process_age_seconds(pid) for pid, _command in group}
            known_ages = {pid: age for pid, age in ages.items() if age is not None}
            newest_pid = min(known_ages, key=known_ages.get) if known_ages else max(pid for pid, _command in group)
            for pid, _command in group:
                if pid == newest_pid:
                    continue
                age = ages.get(pid)
                if respect_duplicate_grace and age is not None and age < DUPLICATE_MCP_GRACE_SECONDS:
                    skipped_young.append(pid)
                    continue
                if _kill_pid(pid):
                    killed.append(pid)
    return {
        "running": len(matches),
        "killed": killed,
        "skipped_young": skipped_young,
        "duplicate_grace_seconds": DUPLICATE_MCP_GRACE_SECONDS,
        "respect_duplicate_grace": respect_duplicate_grace,
        "kill_orphans": kill_orphans,
    }


def mcp_client_processes() -> list[dict[str, Any]]:
    """Return compact process evidence for native MCP clients."""
    processes: list[dict[str, Any]] = []
    for pid, ppid, command in _processes_matching("SkyComputerUseClient"):
        if not (command.endswith("SkyComputerUseClient mcp") or "SkyComputerUseClient mcp" in command):
            continue
        processes.append(
            {
                "pid": pid,
                "ppid": ppid,
                "age_seconds": _process_age_seconds(pid),
                "command": command,
            }
        )
    processes.sort(key=lambda item: int(item.get("pid") or 0))
    return processes


def mcp_client_ownership_status() -> dict[str, Any]:
    """Return diagnostic native MCP client process ownership evidence."""
    processes = mcp_client_processes()
    by_parent: dict[str, list[int]] = {}
    for process in processes:
        by_parent.setdefault(str(process["ppid"]), []).append(int(process["pid"]))
    duplicate_parents = {ppid: pids for ppid, pids in by_parent.items() if len(pids) > 1}
    active_duplicate_groups = {
        ppid: pids
        for ppid, pids in duplicate_parents.items()
        if ppid not in {"0", "1"}
    }
    return {
        "ok": not duplicate_parents,
        "running": len(processes),
        "processes": processes,
        "duplicate_parents": duplicate_parents,
        "active_duplicate_parents": active_duplicate_groups,
        "requires_operator_cleanup": bool(active_duplicate_groups),
        "expected": "ok=true requires no duplicate native MCP clients under one Codex app-server parent; full ensure keeps the newest client per parent and removes older duplicate native transports",
    }


def _process_age_seconds(pid: int) -> int | None:
    try:
        result = _run_capture(["/bin/ps", "-p", str(pid), "-o", "etime="], timeout=2)
    except Exception:
        return None
    text = result.stdout.strip()
    if not text:
        return None
    days = 0
    if "-" in text:
        day_text, text = text.split("-", 1)
        try:
            days = int(day_text)
        except ValueError:
            return None
    parts = text.split(":")
    try:
        if len(parts) == 3:
            hours, minutes, seconds = (int(part) for part in parts)
        elif len(parts) == 2:
            hours = 0
            minutes, seconds = (int(part) for part in parts)
        else:
            return None
    except ValueError:
        return None
    return (days * 24 * 60 * 60) + (hours * 60 * 60) + (minutes * 60) + seconds


def cleanup_stale_notify_clients(*, kill_stale: bool = True, max_age_seconds: int = 30) -> dict[str, Any]:
    """Remove stuck `turn-ended` native notification helpers.

    Codex invokes the configured `notify` command after turns. Direct native
    `SkyComputerUseClient turn-ended ...` calls have been observed to daemonize
    under launchd and stay alive for minutes. They are not MCP servers, but they
    still share the Computer Use runtime and should not accumulate across
    restarts or fresh threads.
    """
    matches = [
        (pid, ppid, command)
        for pid, ppid, command in _processes_matching("SkyComputerUseClient")
        if command.startswith(str(_runtime_binary_path())) and " turn-ended" in command
    ]
    killed: list[int] = []
    details: list[dict[str, Any]] = []
    for pid, ppid, command in matches:
        age = _process_age_seconds(pid)
        stale = ppid == 1 or (age is not None and age >= max_age_seconds)
        details.append({"pid": pid, "ppid": ppid, "age_seconds": age, "stale": stale})
        if kill_stale and stale and _kill_pid(pid):
            killed.append(pid)
    return {"running": len(matches), "killed": killed, "processes": details}


def _cleanup_service_probe_processes(binary: Path) -> None:
    """Remove service --help probe processes that can daemonize past timeout."""
    exact_command = f"{binary} --help"
    for pid, _ppid, command in _processes_matching(str(binary)):
        if command != exact_command:
            continue
        _kill_pid(pid)


def _launcher_probe_env() -> dict[str, str]:
    env = os.environ.copy()
    env["CODEX_CU_LAUNCHER_SKIP_GUARD"] = "1"
    return env


def _run_capture(
    cmd: list[str],
    *,
    timeout: int = 10,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
        timeout=timeout,
        env=env,
    )


def _runtime_probe(binary: Path) -> tuple[bool, str]:
    if not os.access(binary, os.X_OK):
        return False, f"native binary is not executable: {binary}"
    result = _run_capture([str(binary), "--help"], timeout=10)
    if result.returncode == 0:
        return True, ""
    return False, "\n".join(result.stdout.rstrip().splitlines()[-8:])


def _service_runtime_probe(binary: Path) -> tuple[bool, str]:
    if not os.access(binary, os.X_OK):
        return False, f"native service is not executable: {binary}"
    try:
        result = _run_capture([str(binary), "--help"], timeout=2)
    except subprocess.TimeoutExpired:
        _cleanup_service_probe_processes(binary)
        return True, ""
    finally:
        _cleanup_service_probe_processes(binary)
    if result.returncode == 0:
        return True, ""
    error = "\n".join(result.stdout.rstrip().splitlines()[-8:])
    if MISSING_PRIORITY_ESCALATION_SYMBOL in error:
        return False, error
    # The GUI service can stay resident or exit non-zero for non-service probes.
    # Once dyld succeeds, that is enough for the runtime compatibility check.
    return True, error


def _mcp_tools_probe(binary: Path) -> tuple[bool, list[str], str]:
    if not os.access(binary, os.X_OK):
        return False, [], f"native MCP binary is not executable: {binary}"
    messages = [
        {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": "2024-11-05",
                "capabilities": {},
                "clientInfo": {"name": "codex-computer-use-guard", "version": "1"},
            },
        },
        {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}},
        {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}},
    ]
    request = "\n".join(json.dumps(message, separators=(",", ":")) for message in messages) + "\n"
    try:
        result = subprocess.run(
            [str(binary), "mcp"],
            input=request,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            check=False,
            timeout=10,
            env=_launcher_probe_env(),
        )
    except Exception as exc:  # noqa: BLE001
        return False, [], str(exc)

    tools: list[str] = []
    errors: list[str] = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        try:
            response = json.loads(line)
        except json.JSONDecodeError:
            errors.append(line[-300:])
            continue
        if response.get("id") != 2:
            continue
        if response.get("error"):
            errors.append(json.dumps(response["error"], ensure_ascii=True))
            continue
        result_payload = response.get("result") or {}
        for tool in result_payload.get("tools", []):
            if isinstance(tool, dict) and tool.get("name"):
                tools.append(str(tool["name"]))

    required = set(EXPECTED_NATIVE_MCP_TOOLS)
    missing = sorted(required.difference(tools))
    if result.returncode != 0:
        errors.append(f"native MCP probe exited with {result.returncode}")
    if missing:
        errors.append(f"missing expected tools: {', '.join(missing)}")
    return not errors, tools, "; ".join(errors)


def _mcp_tool_surface(tools: list[str], *, ok: bool) -> dict[str, Any]:
    observed = sorted(set(tools))
    missing = sorted(set(EXPECTED_NATIVE_MCP_TOOLS).difference(observed))
    unexpected = sorted(set(observed).difference(EXPECTED_NATIVE_MCP_TOOLS))
    return {
        "ok": bool(ok) and not missing,
        "expected": list(EXPECTED_NATIVE_MCP_TOOLS),
        "observed": observed,
        "missing": missing,
        "unexpected": unexpected,
    }


def _mcp_tool_call_probe(binary: Path, tool_name: str, arguments: dict[str, Any], *, timeout: int = 15) -> tuple[bool, int | None, str]:
    if not os.access(binary, os.X_OK):
        return False, None, f"native MCP binary is not executable: {binary}"
    messages = [
        {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": "2024-11-05",
                "capabilities": {},
                "clientInfo": {"name": "codex-computer-use-guard-call-probe", "version": "1"},
            },
        },
        {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}},
        {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/call",
            "params": {"name": tool_name, "arguments": arguments},
        },
    ]
    request = "\n".join(json.dumps(message, separators=(",", ":")) for message in messages) + "\n"
    try:
        result = subprocess.run(
            [str(binary), "mcp"],
            input=request,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            check=False,
            timeout=timeout,
            env=_launcher_probe_env(),
        )
    except Exception as exc:  # noqa: BLE001
        return False, None, str(exc)

    errors: list[str] = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        try:
            response = json.loads(line)
        except json.JSONDecodeError:
            continue
        if response.get("id") != 2:
            continue
        if response.get("error"):
            return False, None, json.dumps(response["error"], ensure_ascii=True)
        result_payload = response.get("result") or {}
        if result_payload.get("isError"):
            text = "\n".join(
                str(item.get("text") or "")
                for item in result_payload.get("content") or []
                if isinstance(item, dict)
            )
            return False, None, text[:1000] or f"{tool_name} returned isError"
        text = "\n".join(
            str(item.get("text") or "")
            for item in result_payload.get("content") or []
            if isinstance(item, dict)
        )
        count: int | None = None
        if tool_name == "list_apps":
            payload_text = text.split("\n", 1)[1] if "\n" in text else text
            try:
                apps = json.loads(payload_text)
                if isinstance(apps, list):
                    count = len(apps)
            except Exception:
                count = None
            if not count:
                return False, count, "list_apps returned no parseable app rows"
        return True, count, ""
    if result.returncode != 0:
        errors.append(f"MCP call probe exited with {result.returncode}")
    return False, None, "; ".join(errors) or f"missing response for {tool_name}"


def _register_launch_services(cache_root: Path) -> bool:
    if not LSREGISTER.is_file():
        return False
    unregister_apps = [RUNTIME_APP]
    unregister_apps.extend((HOME / ".Trash").glob("Codex.app.backup.*/Contents/Resources/plugins/openai-bundled/plugins/computer-use/Codex Computer Use.app"))
    unregister_apps.extend(Path("/Applications").glob("Codex.app.backup.*/Contents/Resources/plugins/openai-bundled/plugins/computer-use/Codex Computer Use.app"))
    for app in unregister_apps:
        if not app.exists():
            continue
        _run_capture([str(LSREGISTER), "-u", str(app)], timeout=8)
        client = app / "Contents" / "SharedSupport" / "SkyComputerUseClient.app"
        if client.exists():
            _run_capture([str(LSREGISTER), "-u", str(client)], timeout=8)

    register_apps = [app for app in (SIGNED_MARKETPLACE_APP, _source_service_app_path()) if app.is_dir()]
    if not register_apps:
        register_apps = [_runtime_service_app_path() if RUNTIME_APP.is_dir() else _service_app_path(cache_root)]
    register_paths: list[str] = []
    for service_app in register_apps:
        register_paths.append(str(service_app))
        client_app = service_app / "Contents" / "SharedSupport" / "SkyComputerUseClient.app"
        if client_app.is_dir():
            register_paths.append(str(client_app))
    try:
        result = _run_capture([str(LSREGISTER), "-f", *register_paths], timeout=8)
    except Exception:
        return False
    return result.returncode == 0


def _service_running(binary: Path) -> bool:
    return any(command == str(binary) for _pid, _ppid, command in _processes_matching(str(binary)))


def _computer_use_appdata_privacy_status() -> dict[str, Any]:
    def marker_status(error: str = "") -> dict[str, Any]:
        try:
            marker = json.loads(APPDATA_PRIVACY_MARKER.read_text(encoding="utf-8"))
        except Exception:
            return {"ok": False, "error": error or f"missing TCC database: {USER_TCC_DB}"}
        age_seconds = time.time() - float(marker.get("ts", 0))
        ok = bool(marker.get("ok") and age_seconds <= 30 * 24 * 60 * 60)
        return {
            "ok": ok,
            "source": "marker",
            "age_seconds": round(age_seconds, 3),
            "marker": str(APPDATA_PRIVACY_MARKER),
            "error": error,
        }

    if not USER_TCC_DB.is_file():
        return marker_status(f"missing TCC database: {USER_TCC_DB}")
    query = (
        "select service,auth_value,auth_reason,last_modified "
        "from access where client='com.openai.sky.CUAService' "
        "and client_type=0 and service in "
        "('kTCCServiceSystemPolicyAppData','kTCCServiceSystemPolicyAppBundles') "
        "order by service;"
    )
    try:
        result = _run_capture(["/usr/bin/sqlite3", str(USER_TCC_DB), query], timeout=3)
    except Exception as exc:  # noqa: BLE001
        return marker_status(str(exc))
    if result.returncode != 0:
        return marker_status(" ".join(result.stdout.split())[:500])

    entries: dict[str, dict[str, int]] = {}
    for line in result.stdout.splitlines():
        parts = line.split("|")
        if len(parts) != 4:
            continue
        service, auth_value, auth_reason, last_modified = parts
        try:
            entries[service] = {
                "auth_value": int(auth_value),
                "auth_reason": int(auth_reason),
                "last_modified": int(last_modified),
            }
        except ValueError:
            continue

    # For kTCCServiceSystemPolicyAppData on macOS 15, auth_value 5 is the
    # persisted "allowed app data" state after the user accepts the prompt.
    appdata = entries.get("kTCCServiceSystemPolicyAppData")
    appbundles = entries.get("kTCCServiceSystemPolicyAppBundles")
    appdata_ok = bool(appdata and appdata.get("auth_value") in {2, 5})
    appbundles_ok = appbundles is None or appbundles.get("auth_value") in {2, 5}
    payload = {
        "ok": appdata_ok and appbundles_ok,
        "bundle_id": COMPUTER_USE_SERVICE_BUNDLE_ID,
        "database": str(USER_TCC_DB),
        "entries": entries,
    }
    if payload["ok"]:
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            APPDATA_PRIVACY_MARKER.write_text(
                json.dumps({"ok": True, "ts": time.time(), "bundle_id": COMPUTER_USE_SERVICE_BUNDLE_ID})
                + "\n",
                encoding="utf-8",
            )
        except Exception:
            pass
    return payload


def _warm_service(cache_root: Path) -> tuple[bool, str]:
    service_app = _runtime_service_app_path() if RUNTIME_APP.is_dir() else _service_app_path(cache_root)
    binary = _runtime_service_binary_path() if _runtime_service_binary_path().is_file() else _service_binary_path(cache_root)
    if _service_running(binary):
        return True, ""
    privacy = _computer_use_appdata_privacy_status()
    if privacy.get("ok"):
        return True, "skipped warm start because macOS AppData approval is already persisted"
    before = _diagnostic_crash_count("SkyComputerUseService")
    try:
        result = subprocess.run(
            ["/usr/bin/open", "-gj", str(service_app)],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            timeout=8,
        )
    except Exception as exc:  # noqa: BLE001
        return False, str(exc)
    for _ in range(20):
        if _service_running(binary):
            return True, ""
        time.sleep(0.2)
    after = _diagnostic_crash_count("SkyComputerUseService")
    detail = (result.stderr or "").strip()
    if after > before:
        detail = (detail + " " if detail else "") + "SkyComputerUseService crashed during warm launch"
    return False, detail or "SkyComputerUseService did not stay running after warm launch"


def _diagnostic_crash_count(process_name: str) -> int:
    reports = HOME / "Library" / "Logs" / "DiagnosticReports"
    if not reports.is_dir():
        return 0
    try:
        return sum(1 for _path in reports.glob(f"{process_name}-*.ips"))
    except Exception:
        return 0


def _binary_uses_shim(binary: Path) -> bool:
    result = _run_capture(["/usr/bin/otool", "-L", str(binary)], timeout=10)
    return "@rpath/libswift_Concurrency.dylib" in result.stdout


def _binary_uses_embedded_swift_core(binary: Path) -> bool:
    result = _run_capture(["/usr/bin/otool", "-L", str(binary)], timeout=10)
    return "@rpath/libswiftCore.dylib" in result.stdout


def _priority_escalation_overlay_is_minimal(shim: Path) -> bool:
    if not shim.is_file():
        return False
    symbols = _run_capture(["/usr/bin/nm", "-gU", str(shim)], timeout=10)
    links = _run_capture(["/usr/bin/otool", "-L", str(shim)], timeout=10)
    return (
        MISSING_PRIORITY_ESCALATION_SYMBOL in symbols.stdout
        and "_swift_task_removePriorityEscalationHandler" in symbols.stdout
        and "@rpath/libswiftCore.dylib" not in links.stdout
    )


def _system_swift_has_priority_escalation_symbol() -> bool:
    result = _run_capture(["/usr/bin/nm", "-gU", "/usr/lib/swift/libswift_Concurrency.dylib"], timeout=10)
    return MISSING_PRIORITY_ESCALATION_SYMBOL in result.stdout


def _build_priority_escalation_shim(dest: Path) -> None:
    with tempfile.TemporaryDirectory(prefix="codex-cu-shim-") as tmp_name:
        tmp = Path(tmp_name)
        source = tmp / "libswift_Concurrency_shim.c"
        dylib = tmp / "libswift_Concurrency.dylib"
        source.write_text(PRIORITY_ESCALATION_SHIM_SOURCE + "\n", encoding="utf-8")
        subprocess.run(
            [
                "/usr/bin/clang",
                "-dynamiclib",
                "-arch",
                "arm64",
                "-install_name",
                "@rpath/libswift_Concurrency.dylib",
                "-Wl,-reexport_library,/usr/lib/swift/libswift_Concurrency.dylib",
                str(source),
                "-o",
                str(dylib),
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(dylib, dest)


def _computer_use_entitlements_file() -> Path:
    entitlements = STATE_DIR / "computer-use-native.entitlements.plist"
    entitlements.write_text(
        """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict><key>com.apple.security.application-groups</key><array><string>2DC432GLL2.com.openai.sky.CUAService</string></array><key>com.apple.security.automation.apple-events</key><true/></dict></plist>
""",
        encoding="utf-8",
    )
    return entitlements


def _has_computer_use_entitlements(app: Path) -> bool:
    result = _run_capture(["/usr/bin/codesign", "-d", "--entitlements", ":-", str(app)], timeout=10)
    return (
        "2DC432GLL2.com.openai.sky.CUAService" in result.stdout
        and "com.apple.security.automation.apple-events" in result.stdout
    )


def _patch_priority_escalation_shim(app: Path, binary: Path) -> bool:
    frameworks = app / "Contents" / "Frameworks"
    shim = frameworks / "libswift_Concurrency.dylib"
    backup = binary.with_name(binary.name + ".openai-signed-backup")
    changed = False
    if not backup.exists():
        try:
            shutil.copy2(binary, backup)
        except PermissionError:
            if not backup.exists():
                raise
    elif _binary_uses_embedded_swift_core(binary):
        shutil.copy2(backup, binary)
        changed = True
    _build_priority_escalation_shim(shim)
    changed = True
    if not _binary_uses_shim(binary):
        subprocess.run(
            [
                "/usr/bin/install_name_tool",
                "-change",
                "/usr/lib/swift/libswift_Concurrency.dylib",
                "@rpath/libswift_Concurrency.dylib",
                str(binary),
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        subprocess.run(
            ["/usr/bin/install_name_tool", "-delete_rpath", "/usr/lib/swift", str(binary)],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        changed = True
    entitlements = _computer_use_entitlements_file()
    subprocess.run(
        ["/usr/bin/codesign", "--force", "--deep", "--sign", "-", "--entitlements", str(entitlements), str(app)],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    return changed


def ensure_runtime_compat(cache_root: Path) -> tuple[bool, str]:
    """Patch the local cached service/client for the known macOS 15 Swift gap."""
    signed_binary = _signed_marketplace_binary_path() if _signed_marketplace_binary_path().is_file() else _source_binary_path()
    if signed_binary.is_file():
        signed_ok, _signed_error = _runtime_probe(signed_binary)
        if signed_ok:
            return False, "signed-native"
        if os.environ.get("CODEX_CU_ALLOW_ADHOC_SWIFT_SHIM") != "1":
            return False, "signed-native-failed-adhoc-shim-disabled"

    targets = [
        (_client_app_path(cache_root), _binary_path(cache_root), _runtime_probe),
        (_service_app_path(cache_root), _service_binary_path(cache_root), _service_runtime_probe),
    ]
    if RUNTIME_APP.is_dir():
        targets.extend(
            [
                (_runtime_client_app_path(), _runtime_binary_path(), _runtime_probe),
                (_runtime_service_app_path(), _runtime_service_binary_path(), _service_runtime_probe),
            ]
        )

    if _system_swift_has_priority_escalation_symbol():
        probe_results = [(app, binary, probe, *probe(binary)) for app, binary, probe in targets]
        if all(ok for _app, _binary, _probe, ok, _error in probe_results):
            return False, "native"
        return False, "failed"

    changed = False
    for app, binary, _probe in targets:
        if not binary.is_file():
            continue
        if (
            _binary_uses_shim(binary)
            and not _binary_uses_embedded_swift_core(binary)
            and _priority_escalation_overlay_is_minimal(app / "Contents" / "Frameworks" / "libswift_Concurrency.dylib")
            and _has_computer_use_entitlements(app)
        ):
            continue
        changed = _patch_priority_escalation_shim(app, binary) or changed

    for app, binary, probe in targets:
        if not binary.is_file():
            continue
        if not _binary_uses_shim(binary):
            raise RuntimeError(f"Computer Use Swift compatibility patch failed: {binary} still uses system Swift Concurrency")
        if "SkyComputerUseService" in binary.name:
            continue
        ok, error = probe(binary)
        if not ok:
            raise RuntimeError(f"Computer Use Swift compatibility patch failed: {error}")
    return changed, "swift-priority-escalation-shim"


def _cache_valid(dest: Path, version: str) -> bool:
    manifest = dest / ".codex-plugin" / "plugin.json"
    mcp = dest / ".mcp.json"
    binary = _binary_path(dest)
    if not manifest.is_file() or not mcp.is_file() or not os.access(binary, os.X_OK):
        return False
    try:
        with manifest.open("r", encoding="utf-8-sig") as fh:
            payload = json.load(fh)
    except Exception:
        return False
    return payload.get("name") == "computer-use" and str(payload.get("version")) == version


def _mcp_uses_native_binary(cache_root: Path) -> bool:
    try:
        with (cache_root / ".mcp.json").open("r", encoding="utf-8-sig") as fh:
            payload = json.load(fh)
    except Exception:
        return False
    servers = payload.get("mcpServers") or {}
    command = str(_mcp_command_path())
    expected = {
        "command": command,
        "args": ["mcp"],
    }
    return (servers.get("computer-use") or {}) == expected and "computer_use" not in servers


def _mcp_configured_for_header(config_text: str, header: str, binary: Path) -> bool:
    lines = config_text.splitlines()
    section = _find_section(lines, header)
    if section is None:
        return False
    start, end = section
    body = "\n".join(lines[start + 1 : end])
    return (
        re.search(rf'(?m)^\s*command\s*=\s*{re.escape(json.dumps(str(binary)))}\s*$', body)
        is not None
        and re.search(r'(?m)^\s*args\s*=\s*\[\s*"mcp"\s*\]\s*$', body) is not None
    )


def _direct_mcp_configured(config_text: str, binary: Path) -> bool:
    return _find_section(config_text.splitlines(), DIRECT_MCP_HEADER) is None


def _direct_mcp_alias_configured(config_text: str, binary: Path) -> bool:
    return _find_section(config_text.splitlines(), DIRECT_MCP_ALIAS_HEADER) is None


def _direct_mcp_underscore_configured(config_text: str, binary: Path) -> bool:
    return _find_section(config_text.splitlines(), DIRECT_MCP_UNDERSCORE_HEADER) is None


def _direct_mcp_underscore_alias_configured(config_text: str, binary: Path) -> bool:
    return _find_section(config_text.splitlines(), DIRECT_MCP_UNDERSCORE_ALIAS_HEADER) is None


def _direct_mcp_all_configured(config_text: str, binary: Path) -> bool:
    return all(_find_section(config_text.splitlines(), header) is None for header in ALL_DIRECT_MCP_HEADERS)


def _direct_mcp_absence_status(config_text: str) -> dict[str, Any]:
    lines = config_text.splitlines()
    present = [header for header in ALL_DIRECT_MCP_HEADERS if _find_section(lines, header) is not None]
    return {
        "ok": not present,
        "present": present,
        "checked": ALL_DIRECT_MCP_HEADERS,
    }


def _native_target_safety_boundaries() -> dict[str, Any]:
    return {
        "ok": True,
        "scope": "target_app_policy",
        "blocked_apps": list(NATIVE_TARGET_SAFETY_BLOCKED_APPS),
        "fallback_counts_as_native": False,
        "repairable_by_foundation": False,
        "expected_agent_behavior": (
            "If native Computer Use reports that one of these target apps is not allowed for safety "
            "reasons, treat the target as blocked by upstream native policy. Verify general native "
            "health with safe apps, but do not open the blocked app through AppleScript or another "
            "fallback as a substitute for native Computer Use."
        ),
    }


def _health_layers(
    *,
    configured: bool,
    discoverable: bool,
    runtime_ready: bool,
    native_smoke: dict[str, Any],
    ownership: dict[str, Any],
) -> dict[str, Any]:
    mcp_client_ownership = bool(ownership.get("ok"))
    appserver_rendezvous = runtime_ready and mcp_client_ownership and bool(native_smoke.get("appserver_rendezvous"))
    operational = runtime_ready and mcp_client_ownership and bool(native_smoke.get("operational"))
    second_mouse_verified = operational and bool(native_smoke.get("second_mouse_verified"))
    return {
        "configured": configured,
        "discoverable": discoverable,
        "runtime_ready": runtime_ready,
        "mcp_client_ownership": mcp_client_ownership,
        "appserver_rendezvous": appserver_rendezvous,
        "operational": operational,
        "second_mouse_verified": second_mouse_verified,
    }


def _operational_state(
    *,
    structural_ok: bool,
    health_layers: dict[str, Any],
    native_smoke: dict[str, Any],
    ownership: dict[str, Any] | None = None,
) -> dict[str, str]:
    if bool(health_layers.get("operational")):
        return {
            "state": "native_computer_use_ready",
            "next_step": "Use a fresh Codex thread after install or repair, or continue only after mcp__computer_use__.list_apps succeeds in this thread.",
        }
    if not structural_ok:
        return {
            "state": "repair_incomplete",
            "next_step": "Run codex-computer-use-guard ensure and inspect the failed structural layer.",
        }
    if not bool(health_layers.get("runtime_ready")):
        return {
            "state": "runtime_not_ready",
            "next_step": "Run full ensure and inspect runtime, service, and MCP discovery fields.",
        }
    failure_class = str(native_smoke.get("failure_class") or "")
    if failure_class in {"no_native_smoke_record", "stale_native_smoke"}:
        return {
            "state": "structural_ok_needs_fresh_native_smoke",
            "next_step": "Run codex-computer-use-guard ensure, then use tool_search or a fresh Codex thread for native Computer Use discovery.",
        }
    ownership = ownership or {}
    if not bool(health_layers.get("mcp_client_ownership")) and ownership.get("duplicate_parents"):
        return {
            "state": "structural_ok_duplicate_mcp_clients",
            "next_step": "Run codex-computer-use-guard ensure to collapse duplicate native MCP clients, then retry from a fresh Codex thread.",
        }
    return {
        "state": "structural_ok_native_smoke_failed",
        "next_step": "Inspect native_smoke.failure_class, run full ensure, and use a fresh Codex thread after repair is green.",
    }


def ensure_mcp_native_config(cache_root: Path) -> bool:
    path = cache_root / ".mcp.json"
    try:
        with path.open("r", encoding="utf-8-sig") as fh:
            payload = json.load(fh)
    except Exception:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    servers = payload.setdefault("mcpServers", {})
    if not isinstance(servers, dict):
        servers = {}
        payload["mcpServers"] = servers
    command = str(_mcp_command_path())
    desired = {
        "command": command,
        "args": ["mcp"],
    }
    if servers.get("computer-use") == desired and "computer_use" not in servers:
        return False
    servers["computer-use"] = desired
    servers.pop("computer_use", None)
    tmp = path.with_name(path.name + f".tmp-{os.getpid()}")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)
    return True


def _ensure_text_file(path: Path, content: str, *, executable: bool = False) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    current = path.read_text(encoding="utf-8") if path.exists() else ""
    changed = False
    if current != content:
        tmp = path.with_name(path.name + f".tmp-{os.getpid()}")
        tmp.write_text(content, encoding="utf-8")
        if executable:
            os.chmod(tmp, 0o700)
        os.replace(tmp, path)
        changed = True
    if executable and not os.access(path, os.X_OK):
        os.chmod(path, 0o700)
        changed = True
    return changed


def ensure_canonical_skill_metadata() -> bool:
    if not CANONICAL_COMPUTER_USE_SKILL.is_file():
        return False
    return _ensure_text_file(
        CANONICAL_COMPUTER_USE_SKILL.parent / "agents" / "openai.yaml",
        CANONICAL_SKILL_AGENT_METADATA,
    )


def _canonical_skill_metadata_ok() -> bool:
    path = CANONICAL_COMPUTER_USE_SKILL.parent / "agents" / "openai.yaml"
    return (
        CANONICAL_COMPUTER_USE_SKILL.is_file()
        and path.is_file()
        and path.read_text(encoding="utf-8") == CANONICAL_SKILL_AGENT_METADATA
    )


def _remove_path(path: Path) -> bool:
    if path.is_symlink() or path.is_file():
        path.unlink()
        return True
    if path.is_dir():
        shutil.rmtree(path)
        return True
    return False


def ensure_plugin_skill_suppressed(plugin_root: Path) -> bool:
    """Keep plugin MCP discovery, but do not publish a second visible skill.

    Codex 1.0.793 does not filter skill picker entries by the old shim's
    `metadata.hidden` or `policy.allow_implicit_invocation` fields. Leaving a
    plugin `SKILL.md` therefore creates a visible "Computer Use Shim" entry.
    The native tools are still discovered through the plugin `.mcp.json`, so the
    plugin skill root should be absent and the canonical user-facing skill under
    `~/.codex/skills/macos-computer-use` remains the single visible skill.
    """
    skills_root = plugin_root / "skills"
    skill_dir = skills_root / "computer-use"
    hidden_notice = plugin_root / ".codex-plugin" / "computer-use-skill.hidden.md"
    suppressed_notice = plugin_root / ".codex-plugin" / "computer-use-skill.suppressed.md"
    manifest_path = plugin_root / ".codex-plugin" / "plugin.json"
    if not CANONICAL_COMPUTER_USE_SKILL.is_file():
        return False
    changed = False
    changed = _remove_path(skill_dir) or changed
    try:
        skills_root.rmdir()
        changed = True
    except OSError:
        pass
    if hidden_notice.exists():
        hidden_notice.unlink()
        changed = True
    changed = _ensure_text_file(suppressed_notice, PLUGIN_SKILL_SUPPRESSED_NOTICE) or changed
    try:
        with manifest_path.open("r", encoding="utf-8-sig") as fh:
            manifest = json.load(fh)
    except Exception:
        manifest = None
    if isinstance(manifest, dict) and "skills" in manifest:
        manifest.pop("skills", None)
        tmp = manifest_path.with_name(manifest_path.name + f".tmp-{os.getpid()}")
        tmp.write_text(json.dumps(manifest, indent=2, sort_keys=False) + "\n", encoding="utf-8")
        os.replace(tmp, manifest_path)
        changed = True
    return changed


def _plugin_skill_suppressed_ok(plugin_root: Path) -> bool:
    skills_root = plugin_root / "skills"
    skill_dir = skills_root / "computer-use"
    hidden_notice = plugin_root / ".codex-plugin" / "computer-use-skill.hidden.md"
    suppressed_notice = plugin_root / ".codex-plugin" / "computer-use-skill.suppressed.md"
    manifest_path = plugin_root / ".codex-plugin" / "plugin.json"
    try:
        with manifest_path.open("r", encoding="utf-8-sig") as fh:
            manifest = json.load(fh)
    except Exception:
        return False
    return (
        CANONICAL_COMPUTER_USE_SKILL.is_file()
        and isinstance(manifest, dict)
        and "skills" not in manifest
        and not skill_dir.exists()
        and not hidden_notice.exists()
        and suppressed_notice.is_file()
        and suppressed_notice.read_text(encoding="utf-8") == PLUGIN_SKILL_SUPPRESSED_NOTICE
    )


def _copy_cache(source: Path, dest: Path) -> None:
    tmp = dest.with_name(dest.name + f".tmp-{os.getpid()}")
    if tmp.exists():
        shutil.rmtree(tmp)
    tmp.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(["/usr/bin/ditto", str(source), str(tmp)], check=True)
    if dest.exists():
        shutil.rmtree(dest)
    tmp.rename(dest)


def _runtime_install_valid(cache_root: Path, version: str) -> bool:
    if not RUNTIME_APP.is_dir():
        return False
    try:
        bundle_id = _app_bundle_identifier(RUNTIME_APP)
    except Exception:
        return False
    if bundle_id != COMPUTER_USE_SERVICE_BUNDLE_ID:
        return False
    try:
        with (RUNTIME_APP / "Contents" / "Info.plist").open("rb") as fh:
            payload = plistlib.load(fh)
    except Exception:
        return False
    return (
        str(payload.get("CFBundleVersion") or "") == version.split(".")[-1]
        and _runtime_binary_path().is_file()
        and _runtime_service_binary_path().is_file()
        and _is_openai_signed(_runtime_service_app_path())
        and _is_openai_signed(_runtime_client_app_path())
        and _service_app_path(cache_root).is_dir()
    )


def ensure_runtime_install(cache_root: Path, version: str) -> bool:
    """Keep the LaunchServices runtime aligned with the cached plugin copy.

    The MCP client starts `com.openai.sky.CUAService` by bundle id.
    LaunchServices must resolve that id to `$HOME/.codex/computer-use`, not to
    a stale plugin-cache copy. If that runtime copy is stale or unpatched, real
    tool calls fail even while `tools/list` succeeds.
    """
    if _runtime_install_valid(cache_root, version):
        return False
    tmp = RUNTIME_BASE / f".Codex Computer Use.app.tmp-{os.getpid()}"
    if tmp.exists():
        shutil.rmtree(tmp)
    RUNTIME_BASE.mkdir(parents=True, exist_ok=True)
    source_app = SIGNED_MARKETPLACE_APP if SIGNED_MARKETPLACE_APP.is_dir() else _source_service_app_path()
    if not source_app.is_dir():
        source_app = _service_app_path(cache_root)
    subprocess.run(["/usr/bin/ditto", str(source_app), str(tmp)], check=True)
    if RUNTIME_APP.exists():
        shutil.rmtree(RUNTIME_APP)
    tmp.rename(RUNTIME_APP)
    return True


def ensure_cache() -> tuple[str, Path, bool]:
    manifest = _load_plugin_manifest(COMPUTER_USE_SOURCE)
    version = str(manifest["version"])
    dest = CACHE_BASE / version
    changed = False
    if not _cache_valid(dest, version):
        _copy_cache(COMPUTER_USE_SOURCE, dest)
        changed = True
    return version, dest, changed


def _find_section(lines: list[str], header: str) -> tuple[int, int] | None:
    start = -1
    for idx, line in enumerate(lines):
        if line.strip() == header:
            start = idx
            break
    if start < 0:
        return None
    end = len(lines)
    for idx in range(start + 1, len(lines)):
        stripped = lines[idx].strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            end = idx
            break
    return start, end


def _set_key_in_section(lines: list[str], header: str, key: str, value: str) -> None:
    section = _find_section(lines, header)
    if section is None:
        lines.extend(["", header, f"{key} = {value}"])
        return
    start, end = section
    key_re = re.compile(rf"^\s*{re.escape(key)}\s*=")
    for idx in range(start + 1, end):
        if key_re.match(lines[idx]):
            lines[idx] = f"{key} = {value}"
            return
    lines.insert(start + 1, f"{key} = {value}")


def _ensure_plugin_section(lines: list[str]) -> None:
    section = _find_section(lines, PLUGIN_HEADER)
    if section is None:
        browser = _find_section(lines, BROWSER_HEADER)
        insert_at = None
        if browser is not None:
            insert_at = browser[1]
        else:
            for idx, line in enumerate(lines):
                if line.startswith("[projects.") or line.startswith("[mcp_servers."):
                    insert_at = idx
                    break
        if insert_at is None:
            insert_at = len(lines)
        block = ["", PLUGIN_HEADER, "enabled = true"]
        lines[insert_at:insert_at] = block
        return
    _set_key_in_section(lines, PLUGIN_HEADER, "enabled", "true")


def _ensure_marketplace(lines: list[str]) -> None:
    if _find_section(lines, MARKETPLACE_HEADER) is None:
        lines.extend(
            [
                "",
                MARKETPLACE_HEADER,
                f'last_updated = "{time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}"',
                'source_type = "local"',
                f"source = {json.dumps(str(PATCHED_BUNDLED_MARKETPLACE))}",
            ]
        )
        return
    _set_key_in_section(lines, MARKETPLACE_HEADER, "source_type", '"local"')
    _set_key_in_section(lines, MARKETPLACE_HEADER, "source", json.dumps(str(PATCHED_BUNDLED_MARKETPLACE)))


def _ensure_direct_mcp_server_for_header(lines: list[str], header: str, binary: Path) -> None:
    section = _find_section(lines, header)
    if section is None:
        marketplace = _find_section(lines, MARKETPLACE_HEADER)
        insert_at = marketplace[0] if marketplace is not None else len(lines)
        block = [
            "",
            header,
            f"command = {json.dumps(str(binary))}",
            'args = ["mcp"]',
            "startup_timeout_sec = 15",
            "tool_timeout_sec = 120",
        ]
        lines[insert_at:insert_at] = block
        return
    _set_key_in_section(lines, header, "command", json.dumps(str(binary)))
    _set_key_in_section(lines, header, "args", '["mcp"]')
    _set_key_in_section(lines, header, "startup_timeout_sec", "15")
    _set_key_in_section(lines, header, "tool_timeout_sec", "120")


def _remove_section(lines: list[str], header: str) -> None:
    while True:
        section = _find_section(lines, header)
        if section is None:
            return
        start, end = section
        del lines[start:end]
        while start < len(lines) and start > 0 and lines[start].strip() == "" and lines[start - 1].strip() == "":
            del lines[start]


def _ensure_direct_mcp_server(lines: list[str], binary: Path) -> None:
    for header in DIRECT_MCP_HEADERS:
        _remove_section(lines, header)
    for header in LEGACY_DIRECT_MCP_HEADERS:
        _remove_section(lines, header)


def _computer_use_disabled(config_text: str) -> bool:
    return any(
        COMPUTER_USE_PLUGIN_ID in match.group("body")
        for match in DISABLED_TOOLS_ARRAY_RE.finditer(config_text)
    )


def _scrub_disabled_tools_array(match: re.Match[str]) -> str:
    body = match.group("body")
    if COMPUTER_USE_PLUGIN_ID not in body:
        return match.group(0)
    body = COMPUTER_USE_DISABLED_TOOL_TEXT_RE.sub("", body)
    body = COMPUTER_USE_DISABLED_TOOL_STRING_RE.sub("", body)
    body = re.sub(r",\s*,", ",", body, flags=re.DOTALL)
    body = re.sub(r"^\s*,\s*", "", body, flags=re.DOTALL)
    body = re.sub(r"\s*,\s*$", "", body, flags=re.DOTALL)
    if not body.strip():
        return ""
    return f"{match.group('prefix')}{body}{match.group('suffix')}"


def _scrub_computer_use_disabled_tool(config_text: str) -> str:
    object_pattern = COMPUTER_USE_DISABLED_TOOL_TEXT_RE.pattern
    scrubbed = re.sub(r",\s*" + object_pattern, "", config_text, flags=re.DOTALL)
    scrubbed = re.sub(object_pattern + r"\s*,\s*", "", scrubbed, flags=re.DOTALL)
    scrubbed = COMPUTER_USE_DISABLED_TOOL_TEXT_RE.sub("", scrubbed)
    scrubbed = DISABLED_TOOLS_ARRAY_RE.sub(_scrub_disabled_tools_array, scrubbed)
    scrubbed = re.sub(
        r"(?m)^\s*disabled_tools\s*=\s*\[\s*\]\s*\n?",
        "",
        scrubbed,
    )
    return scrubbed


def _remove_computer_use_from_disabled_tools_line(line: str) -> str | None:
    prefix, sep, value = line.partition("=")
    if not sep or prefix.strip() != "disabled_tools" or COMPUTER_USE_PLUGIN_ID not in value:
        return line

    stripped = value.strip()
    if not (stripped.startswith("[") and stripped.endswith("]")):
        return line

    entries = re.findall(r"\{[^{}]*\}|\"[^\"\n]*\"|'[^'\n]*'", stripped[1:-1])
    kept = [
        entry
        for entry in entries
        if COMPUTER_USE_PLUGIN_ID not in entry
        and not COMPUTER_USE_DISABLED_TOOL_RE.fullmatch(entry.strip())
    ]
    if not kept:
        return None
    return f"{prefix.rstrip()} = [{', '.join(kept)}]"


def _ensure_tool_suggest_allows_computer_use(lines: list[str]) -> None:
    section = _find_section(lines, TOOL_SUGGEST_HEADER)
    if section is None:
        return
    start, end = section
    idx = start + 1
    while idx < end:
        replacement = _remove_computer_use_from_disabled_tools_line(lines[idx])
        if replacement is None:
            del lines[idx]
            end -= 1
            continue
        lines[idx] = replacement
        idx += 1


def _ensure_notify(lines: list[str], notify_command: Path) -> None:
    value = f"notify = [{json.dumps(str(notify_command))}, \"turn-ended\"]"
    for idx, line in enumerate(lines):
        if re.match(r"^\s*notify\s*=", line):
            lines[idx] = value
            return
    insert_at = 0
    for idx, line in enumerate(lines):
        if line.startswith("[features]"):
            insert_at = idx
            break
        if re.match(r"^\s*approval_policy\s*=", line):
            insert_at = idx + 1
    lines[insert_at:insert_at] = ["", value]


def ensure_config(cache_root: Path) -> bool:
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    original = CONFIG.read_text(encoding="utf-8") if CONFIG.exists() else ""
    lines = original.splitlines()
    mcp_command = _mcp_command_path()
    _ensure_notify(lines, COMPUTER_USE_NOTIFY)
    _ensure_plugin_section(lines)
    _ensure_direct_mcp_server(lines, mcp_command)
    _ensure_marketplace(lines)
    _ensure_tool_suggest_allows_computer_use(lines)
    updated = _scrub_computer_use_disabled_tool("\n".join(lines).rstrip() + "\n")
    if updated == original:
        return False
    tmp = CONFIG.with_name(CONFIG.name + f".tmp-{os.getpid()}")
    tmp.write_text(updated, encoding="utf-8")
    os.replace(tmp, CONFIG)
    return True


def ensure() -> dict[str, Any]:
    app_bundle_id = _verify_openai_codex_app()
    codex_app_path_state_changed = _ensure_codex_app_path_state()
    if not COMPUTER_USE_SOURCE.is_dir():
        raise RuntimeError(f"missing app-bundled computer-use plugin: {COMPUTER_USE_SOURCE}")
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open("w", encoding="utf-8") as lock_fh:
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX)
        patched_marketplace_changed = ensure_patched_bundled_marketplace()
        tmp_marketplace_changed = ensure_tmp_bundled_marketplace()
        version, cache_root, cache_changed = ensure_cache()
        runtime_install_changed = ensure_runtime_install(cache_root, version)
        broker_backup_changed = ensure_broker_backup()
        native_launcher_changed = ensure_native_launcher()
        notify_wrapper_changed = ensure_notify_wrapper()
        mcp_changed = ensure_mcp_native_config(cache_root)
        plugin_skill_changed = ensure_plugin_skill_suppressed(cache_root)
        canonical_skill_metadata_changed = ensure_canonical_skill_metadata()
        config_changed = ensure_config(cache_root)
        appdata_privacy = _computer_use_appdata_privacy_status()
        runtime_patch_changed, runtime_patch = ensure_runtime_compat(cache_root)
        launch_services_registered = _register_launch_services(cache_root)
        service_warm_ok, service_warm_error = _warm_service(cache_root)
        stale_mcp_cleanup = cleanup_stale_mcp_clients(kill_duplicates=False)
        stale_notify_cleanup = cleanup_stale_notify_clients()
        launch_agent_changed, launch_agent_loaded = ensure_launch_agent()
        dialog_autopilot = ensure_dialog_autopilot()
    binary = _preferred_native_binary_path(cache_root)
    service_binary = _preferred_service_binary_path(cache_root)
    config_text = CONFIG.read_text(encoding="utf-8") if CONFIG.exists() else ""
    computer_use_disabled = _computer_use_disabled(config_text)
    marketplace_source = str(PATCHED_BUNDLED_MARKETPLACE) in config_text
    mcp_command = _mcp_command_path()
    direct_mcp_config = _direct_mcp_configured(config_text, mcp_command)
    direct_mcp_alias_config = _direct_mcp_alias_configured(config_text, mcp_command)
    direct_mcp_underscore_config = _direct_mcp_underscore_configured(config_text, mcp_command)
    direct_mcp_underscore_alias_config = _direct_mcp_underscore_alias_configured(config_text, mcp_command)
    runtime_ok, runtime_error = _runtime_probe(binary)
    mcp_tools_ok, mcp_tools, mcp_tools_error = _mcp_tools_probe(mcp_command) if mcp_command.is_file() else (False, [], "")
    mcp_tool_surface = _mcp_tool_surface(mcp_tools, ok=mcp_tools_ok)
    mcp_list_apps_call_ok, mcp_list_apps_count, mcp_list_apps_error = (
        _mcp_tool_call_probe(mcp_command, "list_apps", {}, timeout=15)
        if mcp_command.is_file() and os.environ.get("CODEX_CU_STANDALONE_TOOL_CALL_PROBE") == "1"
        else (
            True,
            None,
            "skipped standalone list_apps probe; native tool calls require Codex AppServer rendezvous context",
        )
    )
    patched_marketplace_wrapper_ok, patched_marketplace_wrapper_error = _plugin_local_mcp_wrapper_runtime_probe(
        PATCHED_BUNDLED_MARKETPLACE / "plugins" / "computer-use"
    )
    tmp_marketplace_wrapper_ok, tmp_marketplace_wrapper_error = _plugin_local_mcp_wrapper_runtime_probe(
        TMP_BUNDLED_MARKETPLACE / "plugins" / "computer-use"
    )
    if appdata_privacy.get("ok"):
        service_runtime_ok, service_runtime_error = (
            True,
            "skipped service runtime probe because macOS AppData approval is already persisted",
        )
    else:
        service_runtime_ok, service_runtime_error = _service_runtime_probe(service_binary)
    service_ready = _service_running(service_binary) or bool(appdata_privacy.get("ok"))
    direct_mcp_absence = _direct_mcp_absence_status(config_text)
    ownership = mcp_client_ownership_status()
    configured = (
        launch_agent_loaded
        and not computer_use_disabled
        and marketplace_source
        and _patched_bundled_marketplace_ok()
        and _tmp_bundled_marketplace_ok()
        and _bundled_marketplace_version_ok(PATCHED_BUNDLED_MARKETPLACE, version)
        and _bundled_marketplace_version_ok(TMP_BUNDLED_MARKETPLACE, version)
        and patched_marketplace_wrapper_ok
        and tmp_marketplace_wrapper_ok
        and _native_launcher_ok()
        and _notify_wrapper_ok()
        and _canonical_skill_metadata_ok()
        and direct_mcp_absence["ok"]
    )
    discoverable = configured and mcp_tools_ok
    runtime_ready = discoverable and runtime_ok and service_runtime_ok and service_warm_ok and service_ready
    native_smoke = _native_smoke_status()
    native_smoke_refreshed = False
    native_smoke_refresh_error = ""
    if runtime_ready and not native_smoke.get("operational"):
        try:
            native_smoke = _run_native_smoke()
            native_smoke_refreshed = True
        except Exception as exc:  # noqa: BLE001
            native_smoke_refresh_error = str(exc)
            _log("error", "native smoke refresh failed", command="ensure", error=native_smoke_refresh_error)
            native_smoke = _native_smoke_status()
    post_smoke_mcp_cleanup = {
        "running": 0,
        "killed": [],
        "skipped_young": [],
        "duplicate_grace_seconds": DUPLICATE_MCP_GRACE_SECONDS,
        "respect_duplicate_grace": True,
    }
    if runtime_ready:
        post_smoke_mcp_cleanup = cleanup_stale_mcp_clients(
            kill_duplicates=True,
            respect_duplicate_grace=False,
        )
        ownership = mcp_client_ownership_status()
    health_layers = _health_layers(
        configured=configured,
        discoverable=discoverable,
        runtime_ready=runtime_ready,
        native_smoke=native_smoke,
        ownership=ownership,
    )
    operational_state = _operational_state(
        structural_ok=runtime_ready,
        health_layers=health_layers,
        native_smoke=native_smoke,
        ownership=ownership,
    )
    status = {
        "ok": health_layers["operational"],
        "structural_ok": runtime_ready,
        "health_layers": health_layers,
        "operational_state": operational_state,
        "native_smoke": native_smoke,
        "native_smoke_refreshed": native_smoke_refreshed,
        "native_smoke_refresh_error": native_smoke_refresh_error,
        "mcp_client_ownership": ownership,
        "native_target_safety_boundaries": _native_target_safety_boundaries(),
        "openai_codex_app": str(OPENAI_CODEX_APP),
        "codex_app_path_state": str(CODEX_APP_PATH_STATE),
        "codex_app_path_state_changed": codex_app_path_state_changed,
        "openai_codex_bundle_id": app_bundle_id,
        "version": version,
        "cache_root": str(cache_root),
        "binary": str(binary),
        "mcp_command": str(mcp_command),
        "service_binary": str(service_binary),
        "runtime_ok": runtime_ok,
        "runtime_error": runtime_error,
        "mcp_tools_ok": mcp_tools_ok,
        "mcp_tools": mcp_tools,
        "mcp_tools_error": mcp_tools_error,
        "mcp_tool_surface": mcp_tool_surface,
        "expected_mcp_tools": list(EXPECTED_NATIVE_MCP_TOOLS),
        "mcp_tools_missing": mcp_tool_surface["missing"],
        "mcp_list_apps_call_ok": mcp_list_apps_call_ok,
        "mcp_list_apps_count": mcp_list_apps_count,
        "mcp_list_apps_error": mcp_list_apps_error,
        "service_runtime_ok": service_runtime_ok,
        "service_runtime_error": service_runtime_error,
        "service_ready": service_ready,
        "service_appdata_privacy": appdata_privacy,
        "cache_changed": cache_changed,
        "runtime_install_changed": runtime_install_changed,
        "broker_backup_changed": broker_backup_changed,
        "broker_backup_exists": BROKER_BACKUP.is_file(),
        "native_launcher": str(COMPUTER_USE_NATIVE_LAUNCHER),
        "native_launcher_changed": native_launcher_changed,
        "native_launcher_ok": _native_launcher_ok(),
        "notify_wrapper": str(COMPUTER_USE_NOTIFY),
        "notify_wrapper_changed": notify_wrapper_changed,
        "notify_wrapper_ok": _notify_wrapper_ok(),
        "runtime_app": str(RUNTIME_APP),
        "patched_marketplace_changed": patched_marketplace_changed,
        "patched_marketplace": str(PATCHED_BUNDLED_MARKETPLACE),
        "patched_marketplace_ok": _patched_bundled_marketplace_ok(),
        "patched_marketplace_version_ok": _bundled_marketplace_version_ok(PATCHED_BUNDLED_MARKETPLACE, version),
        "patched_marketplace_wrapper_ok": patched_marketplace_wrapper_ok,
        "patched_marketplace_wrapper_error": patched_marketplace_wrapper_error,
        "tmp_marketplace_changed": tmp_marketplace_changed,
        "tmp_marketplace_ok": _tmp_bundled_marketplace_ok(),
        "tmp_marketplace_version_ok": _bundled_marketplace_version_ok(TMP_BUNDLED_MARKETPLACE, version),
        "tmp_marketplace_wrapper_ok": tmp_marketplace_wrapper_ok,
        "tmp_marketplace_wrapper_error": tmp_marketplace_wrapper_error,
        "mcp_changed": mcp_changed,
        "plugin_skill_changed": plugin_skill_changed,
        "plugin_skill_suppressed_ok": _plugin_skill_suppressed_ok(cache_root),
        "plugin_skill_hidden_ok": _plugin_skill_suppressed_ok(cache_root),
        "plugin_skill_consolidated": _plugin_skill_suppressed_ok(cache_root),
        "canonical_skill_metadata_changed": canonical_skill_metadata_changed,
        "canonical_skill_metadata_ok": _canonical_skill_metadata_ok(),
        "config_changed": config_changed,
        "computer_use_disabled": computer_use_disabled,
        "marketplace_source": marketplace_source,
        "direct_mcp_config": direct_mcp_config,
        "direct_mcp_alias_config": direct_mcp_alias_config,
        "direct_mcp_underscore_config": direct_mcp_underscore_config,
        "direct_mcp_underscore_alias_config": direct_mcp_underscore_alias_config,
        "direct_mcp_absence": direct_mcp_absence,
        "runtime_patch": runtime_patch,
        "runtime_patch_changed": runtime_patch_changed,
        "launch_services_registered": launch_services_registered,
        "service_warm_ok": service_warm_ok,
        "service_warm_error": service_warm_error,
        "stale_mcp_cleanup": stale_mcp_cleanup,
        "post_smoke_mcp_cleanup": post_smoke_mcp_cleanup,
        "stale_notify_cleanup": stale_notify_cleanup,
        "launch_agent": str(LAUNCH_AGENT),
        "launch_agent_changed": launch_agent_changed,
        "launch_agent_loaded": launch_agent_loaded,
        "bootstrap": str(BOOTSTRAP),
        "bootstrap_exists": BOOTSTRAP.is_file(),
        "guard_backup": str(GUARD_BACKUP),
        "guard_backup_exists": GUARD_BACKUP.is_file(),
        "dialog_autopilot": dialog_autopilot,
    }
    if (
        cache_changed
        or patched_marketplace_changed
        or tmp_marketplace_changed
        or config_changed
        or runtime_install_changed
        or broker_backup_changed
        or native_launcher_changed
        or notify_wrapper_changed
        or mcp_changed
        or plugin_skill_changed
        or canonical_skill_metadata_changed
        or runtime_patch_changed
        or stale_mcp_cleanup.get("killed")
        or post_smoke_mcp_cleanup.get("killed")
        or stale_notify_cleanup.get("killed")
        or launch_agent_changed
        or launch_services_registered
        or codex_app_path_state_changed
    ):
        _log("info", "computer-use repaired", **status)
    return status


def status() -> dict[str, Any]:
    app_bundle_id = _verify_openai_codex_app()
    manifest = _load_plugin_manifest(COMPUTER_USE_SOURCE)
    version = str(manifest["version"])
    cache_root = CACHE_BASE / version
    config_text = CONFIG.read_text(encoding="utf-8") if CONFIG.exists() else ""
    runtime_install_valid = _runtime_install_valid(cache_root, version)
    binary = _preferred_native_binary_path(cache_root)
    service_binary = _preferred_service_binary_path(cache_root)
    plugin_enabled = bool(
        re.search(r'\[plugins\."computer-use@openai-bundled"\]\s+enabled\s*=\s*true', config_text)
    )
    computer_use_disabled = _computer_use_disabled(config_text)
    cache_valid = _cache_valid(cache_root, version)
    plugin_skill_suppressed_ok = _plugin_skill_suppressed_ok(cache_root)
    canonical_skill_metadata_ok = _canonical_skill_metadata_ok()
    mcp_native_config = _mcp_uses_native_binary(cache_root)
    marketplace_source = str(PATCHED_BUNDLED_MARKETPLACE) in config_text
    patched_marketplace_version_ok = _bundled_marketplace_version_ok(PATCHED_BUNDLED_MARKETPLACE, version)
    tmp_marketplace_version_ok = _bundled_marketplace_version_ok(TMP_BUNDLED_MARKETPLACE, version)
    tmp_marketplace_ok = _tmp_bundled_marketplace_ok()
    notify_binary = str(COMPUTER_USE_NOTIFY) in config_text and _notify_wrapper_ok()
    mcp_command = _mcp_command_path()
    direct_mcp_config = _direct_mcp_configured(config_text, mcp_command)
    direct_mcp_alias_config = _direct_mcp_alias_configured(config_text, mcp_command)
    direct_mcp_underscore_config = _direct_mcp_underscore_configured(config_text, mcp_command)
    direct_mcp_underscore_alias_config = _direct_mcp_underscore_alias_configured(config_text, mcp_command)
    runtime_ok, runtime_error = _runtime_probe(binary) if cache_valid else (False, "")
    mcp_tools_ok, mcp_tools, mcp_tools_error = (
        _mcp_tools_probe(mcp_command) if cache_valid and mcp_command.is_file() else (False, [], "")
    )
    mcp_tool_surface = _mcp_tool_surface(mcp_tools, ok=mcp_tools_ok)
    mcp_list_apps_call_ok, mcp_list_apps_count, mcp_list_apps_error = (
        _mcp_tool_call_probe(mcp_command, "list_apps", {}, timeout=15)
        if cache_valid
        and mcp_command.is_file()
        and os.environ.get("CODEX_CU_STANDALONE_TOOL_CALL_PROBE") == "1"
        else (
            True,
            None,
            "skipped standalone list_apps probe; native tool calls require Codex AppServer rendezvous context",
        )
    )
    patched_marketplace_wrapper_ok, patched_marketplace_wrapper_error = _plugin_local_mcp_wrapper_runtime_probe(
        PATCHED_BUNDLED_MARKETPLACE / "plugins" / "computer-use"
    )
    tmp_marketplace_wrapper_ok, tmp_marketplace_wrapper_error = _plugin_local_mcp_wrapper_runtime_probe(
        TMP_BUNDLED_MARKETPLACE / "plugins" / "computer-use"
    )
    appdata_privacy = _computer_use_appdata_privacy_status()
    if not cache_valid:
        service_runtime_ok, service_runtime_error = (False, "")
    elif appdata_privacy.get("ok"):
        service_runtime_ok, service_runtime_error = (
            True,
            "skipped service runtime probe because macOS AppData approval is already persisted",
        )
    else:
        service_runtime_ok, service_runtime_error = _service_runtime_probe(service_binary)
    runtime_patch = (
        "swift-priority-escalation-shim"
        if _binary_uses_shim(binary) or _binary_uses_shim(service_binary)
        else "native"
    )
    stale_mcp_clients = cleanup_stale_mcp_clients(kill_duplicates=False, kill_orphans=False)
    stale_notify_clients = cleanup_stale_notify_clients(kill_stale=False)
    service_running = _service_running(service_binary)
    service_ready = service_running or bool(appdata_privacy.get("ok"))
    launch_agent_exists = LAUNCH_AGENT.is_file()
    launch_agent_config_ok = _launch_agent_config_ok()
    launch_agent_loaded = _launch_agent_loaded()
    bootstrap_exists = BOOTSTRAP.is_file()
    guard_backup_exists = GUARD_BACKUP.is_file()
    broker_exists = COMPUTER_USE_BROKER.is_file()
    broker_backup_exists = BROKER_BACKUP.is_file()
    native_launcher_exists = COMPUTER_USE_NATIVE_LAUNCHER.is_file()
    native_launcher_ok = _native_launcher_ok()
    dialog_autopilot = dialog_autopilot_status()
    direct_mcp_absence = _direct_mcp_absence_status(config_text)
    native_smoke = _native_smoke_status()
    ownership = mcp_client_ownership_status()
    configured = (
        cache_valid
        and plugin_enabled
        and not computer_use_disabled
        and marketplace_source
        and _patched_bundled_marketplace_ok()
        and tmp_marketplace_ok
        and patched_marketplace_version_ok
        and tmp_marketplace_version_ok
        and patched_marketplace_wrapper_ok
        and tmp_marketplace_wrapper_ok
        and native_launcher_ok
        and notify_binary
        and mcp_native_config
        and plugin_skill_suppressed_ok
        and canonical_skill_metadata_ok
        and runtime_install_valid
        and direct_mcp_absence["ok"]
        and app_bundle_id == OPENAI_CODEX_BUNDLE_ID
        and launch_agent_exists
        and launch_agent_config_ok
        and launch_agent_loaded
        and bootstrap_exists
        and guard_backup_exists
        and broker_exists
        and broker_backup_exists
    )
    discoverable = configured and mcp_tools_ok
    runtime_ready = discoverable and runtime_ok and service_runtime_ok and service_ready
    health_layers = _health_layers(
        configured=configured,
        discoverable=discoverable,
        runtime_ready=runtime_ready,
        native_smoke=native_smoke,
        ownership=ownership,
    )
    operational_state = _operational_state(
        structural_ok=runtime_ready,
        health_layers=health_layers,
        native_smoke=native_smoke,
        ownership=ownership,
    )
    return {
        "ok": health_layers["operational"],
        "structural_ok": runtime_ready,
        "health_layers": health_layers,
        "operational_state": operational_state,
        "native_smoke": native_smoke,
        "mcp_client_ownership": ownership,
        "native_target_safety_boundaries": _native_target_safety_boundaries(),
        "openai_codex_app": str(OPENAI_CODEX_APP),
        "codex_app_path_state": str(CODEX_APP_PATH_STATE),
        "codex_app_path_state_exists": CODEX_APP_PATH_STATE.is_file(),
        "openai_codex_bundle_id": app_bundle_id,
        "version": version,
        "cache_valid": cache_valid,
        "runtime_install_valid": runtime_install_valid,
        "runtime_app": str(RUNTIME_APP),
        "plugin_enabled": plugin_enabled,
        "computer_use_disabled": computer_use_disabled,
        "mcp_native_config": mcp_native_config,
        "plugin_skill_suppressed_ok": plugin_skill_suppressed_ok,
        "plugin_skill_hidden_ok": plugin_skill_suppressed_ok,
        "plugin_skill_consolidated": plugin_skill_suppressed_ok,
        "canonical_skill_metadata_ok": canonical_skill_metadata_ok,
        "direct_mcp_config": direct_mcp_config,
        "direct_mcp_alias_config": direct_mcp_alias_config,
        "direct_mcp_underscore_config": direct_mcp_underscore_config,
        "direct_mcp_underscore_alias_config": direct_mcp_underscore_alias_config,
        "direct_mcp_absence": direct_mcp_absence,
        "marketplace_source": marketplace_source,
        "patched_marketplace": str(PATCHED_BUNDLED_MARKETPLACE),
        "patched_marketplace_ok": _patched_bundled_marketplace_ok(),
        "patched_marketplace_version_ok": patched_marketplace_version_ok,
        "patched_marketplace_wrapper_ok": patched_marketplace_wrapper_ok,
        "patched_marketplace_wrapper_error": patched_marketplace_wrapper_error,
        "tmp_marketplace_ok": tmp_marketplace_ok,
        "tmp_marketplace_version_ok": tmp_marketplace_version_ok,
        "tmp_marketplace_wrapper_ok": tmp_marketplace_wrapper_ok,
        "tmp_marketplace_wrapper_error": tmp_marketplace_wrapper_error,
        "notify_binary": notify_binary,
        "notify_wrapper": str(COMPUTER_USE_NOTIFY),
        "notify_wrapper_ok": _notify_wrapper_ok(),
        "runtime_ok": runtime_ok,
        "runtime_error": runtime_error,
        "mcp_tools_ok": mcp_tools_ok,
        "mcp_tools": mcp_tools,
        "mcp_tools_error": mcp_tools_error,
        "mcp_tool_surface": mcp_tool_surface,
        "expected_mcp_tools": list(EXPECTED_NATIVE_MCP_TOOLS),
        "mcp_tools_missing": mcp_tool_surface["missing"],
        "mcp_list_apps_call_ok": mcp_list_apps_call_ok,
        "mcp_list_apps_count": mcp_list_apps_count,
        "mcp_list_apps_error": mcp_list_apps_error,
        "service_runtime_ok": service_runtime_ok,
        "service_runtime_error": service_runtime_error,
        "runtime_patch": runtime_patch,
        "service_running": service_running,
        "service_ready": service_ready,
        "service_appdata_privacy": appdata_privacy,
        "stale_mcp_clients": stale_mcp_clients,
        "stale_notify_clients": stale_notify_clients,
        "launch_agent": str(LAUNCH_AGENT),
        "launch_agent_exists": launch_agent_exists,
        "launch_agent_config_ok": launch_agent_config_ok,
        "launch_agent_loaded": launch_agent_loaded,
        "bootstrap": str(BOOTSTRAP),
        "bootstrap_exists": bootstrap_exists,
        "guard_backup": str(GUARD_BACKUP),
        "guard_backup_exists": guard_backup_exists,
        "broker": str(COMPUTER_USE_BROKER),
        "broker_exists": broker_exists,
        "broker_backup": str(BROKER_BACKUP),
        "broker_backup_exists": broker_backup_exists,
        "native_launcher": str(COMPUTER_USE_NATIVE_LAUNCHER),
        "native_launcher_exists": native_launcher_exists,
        "native_launcher_ok": native_launcher_ok,
        "dialog_autopilot": dialog_autopilot,
        "cache_root": str(cache_root),
        "binary": str(binary),
        "mcp_command": str(mcp_command),
        "service_binary": str(service_binary),
    }


def main(argv: list[str]) -> int:
    command = argv[1] if len(argv) > 1 and not argv[1].startswith("-") else "ensure"
    quiet = "--quiet" in argv
    try:
        if command == "status":
            payload = status()
        elif command == "record-native-smoke":
            payload = _record_native_smoke_from_stdin()
        elif command in {"run-native-smoke", "fresh-native-smoke", "fresh-smoke"}:
            payload = _run_native_smoke()
        elif command == "clear-native-smoke":
            try:
                NATIVE_SMOKE_STATUS.unlink()
            except FileNotFoundError:
                pass
            payload = _native_smoke_status()
        elif command == "cleanup-mcp-clients":
            force_duplicates = "--force-duplicates" in argv
            if force_duplicates:
                os.environ["CODEX_CU_FORCE_KILL_DUPLICATE_MCP"] = "1"
            before = mcp_client_ownership_status()
            cleanup = cleanup_stale_mcp_clients(
                kill_duplicates=force_duplicates,
                respect_duplicate_grace=not force_duplicates,
            )
            after = mcp_client_ownership_status()
            payload = {
                "ok": True,
                "command": command,
                "force_duplicates": force_duplicates,
                "cleanup": cleanup,
                "before": {
                    "ok": before.get("ok"),
                    "running": before.get("running"),
                    "duplicate_parents": before.get("duplicate_parents"),
                },
                "after": {
                    "ok": after.get("ok"),
                    "running": after.get("running"),
                    "duplicate_parents": after.get("duplicate_parents"),
                },
            }
        elif command in {"ensure-config", "repair-config"}:
            LOCK.parent.mkdir(parents=True, exist_ok=True)
            ensure_config_lock_fh = LOCK.open("w", encoding="utf-8")
            fcntl.flock(ensure_config_lock_fh.fileno(), fcntl.LOCK_EX)
            codex_app_path_state_changed = _ensure_codex_app_path_state()
            patched_marketplace_changed = ensure_patched_bundled_marketplace()
            tmp_marketplace_changed = ensure_tmp_bundled_marketplace()
            version, cache_root, cache_changed = ensure_cache()
            runtime_install_changed = ensure_runtime_install(cache_root, version)
            broker_backup_changed = ensure_broker_backup()
            native_launcher_changed = ensure_native_launcher()
            notify_wrapper_changed = ensure_notify_wrapper()
            mcp_changed = ensure_mcp_native_config(cache_root)
            plugin_skill_changed = ensure_plugin_skill_suppressed(cache_root)
            canonical_skill_metadata_changed = ensure_canonical_skill_metadata()
            changed = ensure_config(cache_root)
            runtime_patch_changed, runtime_patch = ensure_runtime_compat(cache_root)
            stale_notify_cleanup = cleanup_stale_notify_clients(max_age_seconds=5)
            launch_agent_changed, launch_agent_loaded = ensure_launch_agent()
            dialog_autopilot = ensure_dialog_autopilot()
            config_text = CONFIG.read_text(encoding="utf-8") if CONFIG.exists() else ""
            binary = _runtime_binary_path() if _runtime_binary_path().is_file() else _binary_path(cache_root)
            mcp_command = _mcp_command_path()
            direct_mcp_absence = _direct_mcp_absence_status(config_text)
            structural_ok = (
                not _computer_use_disabled(config_text)
                and str(PATCHED_BUNDLED_MARKETPLACE) in config_text
                and _patched_bundled_marketplace_ok()
                and _tmp_bundled_marketplace_ok()
                and _bundled_marketplace_version_ok(PATCHED_BUNDLED_MARKETPLACE, version)
                and _bundled_marketplace_version_ok(TMP_BUNDLED_MARKETPLACE, version)
                and _canonical_skill_metadata_ok()
                and _native_launcher_ok()
                and _notify_wrapper_ok()
                and direct_mcp_absence["ok"]
                and _launch_agent_config_ok()
                and launch_agent_loaded
                and BOOTSTRAP.is_file()
                and GUARD_BACKUP.is_file()
            )
            native_smoke = _native_smoke_status()
            ownership = mcp_client_ownership_status()
            runtime_ready = (
                structural_ok
                and RUNTIME_APP.is_dir()
                and runtime_patch in {"native", "signed-native", "swift-priority-escalation-shim"}
            )
            health_layers = _health_layers(
                configured=structural_ok,
                discoverable=False,
                runtime_ready=False,
                native_smoke=native_smoke,
                ownership=ownership,
            )
            operational_state = _operational_state(
                structural_ok=structural_ok,
                health_layers=health_layers,
                native_smoke=native_smoke,
                ownership=ownership,
            )
            payload = {
                "ok": False,
                "structural_only": True,
                "structural_ok": structural_ok,
                "health_layers": health_layers,
                "operational_state": operational_state,
                "native_smoke": native_smoke,
                "mcp_client_ownership": ownership,
                "native_target_safety_boundaries": _native_target_safety_boundaries(),
                "command": command,
                "version": version,
                "codex_app_path_state": str(CODEX_APP_PATH_STATE),
                "codex_app_path_state_changed": codex_app_path_state_changed,
                "cache_root": str(cache_root),
                "cache_changed": cache_changed,
                "runtime_install_changed": runtime_install_changed,
                "broker_backup_changed": broker_backup_changed,
                "broker_backup_exists": BROKER_BACKUP.is_file(),
                "native_launcher": str(COMPUTER_USE_NATIVE_LAUNCHER),
                "native_launcher_changed": native_launcher_changed,
                "native_launcher_ok": _native_launcher_ok(),
                "notify_wrapper": str(COMPUTER_USE_NOTIFY),
                "notify_wrapper_changed": notify_wrapper_changed,
                "notify_wrapper_ok": _notify_wrapper_ok(),
                "runtime_app": str(RUNTIME_APP),
                "patched_marketplace_changed": patched_marketplace_changed,
                "patched_marketplace": str(PATCHED_BUNDLED_MARKETPLACE),
                "patched_marketplace_ok": _patched_bundled_marketplace_ok(),
                "patched_marketplace_version_ok": _bundled_marketplace_version_ok(PATCHED_BUNDLED_MARKETPLACE, version),
                "tmp_marketplace_changed": tmp_marketplace_changed,
                "tmp_marketplace_ok": _tmp_bundled_marketplace_ok(),
                "tmp_marketplace_version_ok": _bundled_marketplace_version_ok(TMP_BUNDLED_MARKETPLACE, version),
                "mcp_changed": mcp_changed,
                "plugin_skill_changed": plugin_skill_changed,
                "plugin_skill_suppressed_ok": _plugin_skill_suppressed_ok(cache_root),
                "plugin_skill_hidden_ok": _plugin_skill_suppressed_ok(cache_root),
                "plugin_skill_consolidated": _plugin_skill_suppressed_ok(cache_root),
                "canonical_skill_metadata_changed": canonical_skill_metadata_changed,
                "canonical_skill_metadata_ok": _canonical_skill_metadata_ok(),
                "runtime_patch": runtime_patch,
                "runtime_patch_changed": runtime_patch_changed,
                "config_changed": changed,
                "stale_notify_cleanup": stale_notify_cleanup,
                "launch_agent_changed": launch_agent_changed,
                "launch_agent": str(LAUNCH_AGENT),
                "launch_agent_loaded": launch_agent_loaded,
                "launch_agent_config_ok": _launch_agent_config_ok(),
                "bootstrap": str(BOOTSTRAP),
                "bootstrap_exists": BOOTSTRAP.is_file(),
                "guard_backup": str(GUARD_BACKUP),
                "guard_backup_exists": GUARD_BACKUP.is_file(),
                "dialog_autopilot": dialog_autopilot,
                "computer_use_disabled": _computer_use_disabled(config_text),
                "mcp_command": str(mcp_command),
                "direct_mcp_config": _direct_mcp_configured(config_text, mcp_command),
                "direct_mcp_alias_config": _direct_mcp_alias_configured(config_text, mcp_command),
                "direct_mcp_underscore_config": _direct_mcp_underscore_configured(config_text, mcp_command),
                "direct_mcp_underscore_alias_config": _direct_mcp_underscore_alias_configured(config_text, mcp_command),
                "direct_mcp_absence": direct_mcp_absence,
            }
            fcntl.flock(ensure_config_lock_fh.fileno(), fcntl.LOCK_UN)
            ensure_config_lock_fh.close()
        else:
            payload = ensure()
        if command != "status":
            _write_status_snapshot(payload)
        if not quiet:
            print(json.dumps(payload, indent=2, sort_keys=True))
        if command in {"ensure-config", "repair-config"}:
            return 0 if payload.get("structural_ok") else 1
        return 0 if payload.get("ok") else 1
    except Exception as exc:  # noqa: BLE001
        _log("error", "computer-use guard failed", error=str(exc), command=command)
        if not quiet:
            print(json.dumps({"ok": False, "error": str(exc)}, indent=2, sort_keys=True), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))

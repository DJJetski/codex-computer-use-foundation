def _safe_codex_app_path(value: str) -> Path | None:
    value = value.strip()
    if not value or "\x00" in value:
        return None
    # CODEX_CU_CODEX_APP and codex-app-path are local operator inputs. This
    # function accepts only absolute .app paths; _verify_openai_codex_app then
    # validates CFBundleIdentifier before the value is persisted or used for
    # native smoke execution.
    # codeql[py/path-injection]
    candidate = Path(value)
    if not candidate.is_absolute() or candidate.suffix != ".app":
        return None
    return candidate


def _configured_codex_app_path() -> Path:
    env_path = os.environ.get("CODEX_CU_CODEX_APP", "").strip()
    if env_path:
        safe_env_path = _safe_codex_app_path(env_path)
        if safe_env_path is not None:
            return safe_env_path
    try:
        state_path = CODEX_APP_PATH_STATE.read_text(encoding="utf-8").strip()
    except Exception:
        state_path = ""
    if state_path:
        safe_state_path = _safe_codex_app_path(state_path)
        if safe_state_path is not None:
            return safe_state_path
    return Path("/Applications/Codex.app")


